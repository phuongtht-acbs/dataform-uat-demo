config {
  // ===========================================================================
  // BƯỚC 1: Config metadata của file
  // ===========================================================================
  type: "incremental",
  schema: "silver",
  name: "dim_broker",
  uniqueKey: ["broker_history_key"],                  // Key bảng (nhớ giống với dòng 27)
  tags: ["silver", "dimension", "daily", "broker"],
  bigquery: {
      partitionBy: "DATE(valid_from)",
      clusterBy: ['is_current']
  }
}

js {
  // ============================================================================
  // BƯỚC 2. Điền thông tin về nguồn dữ liệu, key và độ chi tiết
  // ============================================================================
  const bronze_source_table = "BRKTBROKER";         // Tên bảng ở lớp bronze để lấy ngày mới nhất
  const source_schema = "silver";                   // Dataset chứa bảng stage nguồn
  const source_table = "stage_brktbroker";          // Tên bảng stage nguồn
  const partition_col = "snapshot_date";            // Tên cột để filter ngày mới nhất

  const natural_key = "broker_cd";                  // Key tự nhiên
  const tech_key = "broker_cd";                     // Key hệ thống (ví dụ: cust_cd, sub_acco_cd). Nếu không có thì điền lại key tự nhiên
  const surrogate_key = "broker_history_key";           // Tên key bảng (nhớ để cho giống uniqueKey ở dòng 8)

  // ============================================================================
  // BƯỚC 3. Điền các cột ở bảng stage mà cần có ở bảng dim (bao gồm cả key tự nhiên, key hệ thống)
  // ============================================================================
  const dim_cols = [
    "broker_cd", "is_deleted", "parent_broker_cd", "family_name", "given_name",
    "mobile_no", "email_adrs", "adrs_1", "adrs_2", "approval_cd", "id_number",
    "issue_location", "issue_date", "expire_date", "user_id", "transaction_cd",
    "acco_begin_date", "acco_end_date", "employee_type", "ctv_corp_id",
    "acco_sts", "exc_begin_date", "cert_begin_date", "business_type",
    "broker_type_id", "depend_number", "insurance_salary", "basic_salary",
    "end_basic_salary_month", "remarks"
  ];

  // ============================================================================
  // BƯỚC 4: Một số biến hỗ trợ logic (không cần đụng vào)
  // ============================================================================

  const cur_dim_cols = [
    { name: natural_key, type: "STRING" },
    { name: "record_hash", type: "BYTES" },
    { name: surrogate_key, type: "BYTES" },
    { name: "_ingested_at", type: "TIMESTAMP" }
  ];
  const source_ref = ref(source_schema, source_table)
  const checkpoint_ref = ref("silver", "bronze_checkpoint");
}

pre_operations {
  DECLARE run_time TIMESTAMP DEFAULT CURRENT_TIMESTAMP();
  DECLARE target_date DATE;
  
  SET target_date = ${dataform.projectConfig.vars.target_date 
      ? `DATE('${dataform.projectConfig.vars.target_date}')` 
      : `(SELECT latest_date FROM ${checkpoint_ref} WHERE table_name = '${bronze_source_table}')`
  };

  ${when(!incremental(), `DROP TABLE IF EXISTS ${self()};`)}
}

-- ===========================================================================
-- LOGIC SQL (không cần đụng vào)
-- ===========================================================================
${when(!incremental(), `
-- 1. Full Refresh Path: Lead-Lag Logic
WITH all_history AS (
    SELECT
        ${func.generateHash(dim_cols)} AS record_hash,
        ${partition_col},
        ${dim_cols.join(",\n        ")}
    FROM ${source_ref}
    QUALIFY ROW_NUMBER() OVER (
        PARTITION BY ${natural_key}, ${partition_col} ORDER BY ${tech_key} DESC
    ) = 1
),
deduped_history AS (
    SELECT 
        *,
        LAG(record_hash) OVER (PARTITION BY ${natural_key} ORDER BY ${partition_col}) AS prev_hash
    FROM all_history
),
filtered_changes AS (
    SELECT * FROM deduped_history 
    WHERE prev_hash IS NULL OR record_hash != prev_hash
),
scd2_rebuild AS (
    SELECT
        *,
        ${partition_col} AS valid_from_date,
        LEAD(${partition_col}) OVER (PARTITION BY ${natural_key} ORDER BY ${partition_col}) AS valid_to_date
    FROM filtered_changes
)
SELECT
    run_time AS _ingested_at,
    run_time AS _updated_at,
    ${func.generateHash([natural_key, "CAST(valid_from_date AS TIMESTAMP)"])} AS ${surrogate_key},
    CAST(valid_from_date AS TIMESTAMP) AS valid_from,
    CAST(valid_to_date AS TIMESTAMP) AS valid_to,
    (valid_to_date IS NULL) AS is_current,
    * EXCEPT(${partition_col}, prev_hash, valid_from_date, valid_to_date)
FROM scd2_rebuild
`)}

${when(incremental(), `
-- 2. Incremental Path: Comparison Logic
WITH staging_data AS (
    SELECT
        ${func.generateHash(dim_cols)} AS record_hash,
        ${dim_cols.join(",\n        ")}
    FROM ${source_ref}
    WHERE ${partition_col} = target_date
    QUALIFY ROW_NUMBER() OVER (PARTITION BY ${natural_key} ORDER BY ${tech_key} DESC) = 1
),
current_dim AS (
    ${func.getCurrentDim(incremental(), self(), cur_dim_cols)}
)
SELECT
    COALESCE(cur._ingested_at, run_time) AS _ingested_at,
    run_time AS _updated_at,
    ${func.generateHash(["stg." + natural_key, "CAST(target_date AS TIMESTAMP)"])} AS ${surrogate_key},
    CAST(target_date AS TIMESTAMP) AS valid_from,
    CAST(NULL AS TIMESTAMP) AS valid_to,
    true AS is_current,
    stg.*
FROM staging_data AS stg
LEFT JOIN current_dim AS cur ON stg.${natural_key} = cur.${natural_key}
WHERE cur.${natural_key} IS NULL OR stg.record_hash != cur.record_hash
`)}

post_operations {
  ${when(incremental(), `
  MERGE ${self()} AS t
  USING (
    SELECT
      ${natural_key},
      ${func.generateHash(dim_cols)} AS record_hash
    FROM ${source_ref}
    WHERE ${partition_col} = target_date
    QUALIFY ROW_NUMBER() OVER (PARTITION BY ${natural_key} ORDER BY ${tech_key} DESC) = 1
  ) AS src
  ON t.${natural_key} = src.${natural_key} AND t.is_current = true AND t.record_hash != src.record_hash
  WHEN MATCHED THEN 
    UPDATE SET
      t._updated_at = run_time,
      t.valid_to = CAST(target_date AS TIMESTAMP),
      t.is_current = false;
  `)}
}