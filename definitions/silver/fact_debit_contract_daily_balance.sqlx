config {
  // ===========================================================================
  // BƯỚC 1: Config metadata của file
  // ===========================================================================
  type: "incremental",
  schema: "silver",
  name: "fact_debit_contract_daily_balance",
  uniqueKey: ["debit_contract_daily_balance_key"],
  tags: ["silver", "debit_contract", "fact", "daily"],
  bigquery: {
      partitionBy: "business_date",
      updatePartitionFilter: "business_date = target_date"
  }
}

js {
  // ============================================================================
  // BƯỚC 2. Điền thông tin về nguồn dữ liệu, key và độ chi tiết
  // ============================================================================
  const bronze_source_table = "MRGTDEBIT_CONTRACT_HIST";    // Tên bảng ở lớp bronze để lấy ngày mới nhất
  const source_schema = "silver";                           // Dataset chứa bảng stage nguồn
  const source_table = "stage_mrgtdebit_contract_hist";     // Tên bảng stage nguồn
  const partition_col = "business_date";                    // Cột phân vùng (business_date)

  const surrogate_key = "debit_contract_daily_balance_key"; // Tên key bảng
  const hash_elements = ["contract_id", "business_date"];   // Các thành phần cấu tạo nên hash key

  // ============================================================================
  // BƯỚC 3. Điền các cột ở bảng stage mà cần có ở bảng fact
  // ============================================================================
  const fact_cols = [
    "business_date", "contract_id", "allo_date", "ref_no", "sub_acco_no", "is_deleted",
    "amount", "payed_amount", "payed_interest", "due_interest", "payed_manager", 
    "due_manager", "last_payed_date"
  ];

  // ============================================================================
  // BƯỚC 4: Một số biến hỗ trợ logic (không cần đụng vào)
  // ============================================================================
  const source_ref = ref(source_schema, source_table);
  const checkpoint_ref = ref("silver", "bronze_checkpoint");
}

-- ===========================================================================
-- LOGIC SQL (không cần đụng vào)
-- ===========================================================================
pre_operations {
  DECLARE run_time TIMESTAMP DEFAULT CURRENT_TIMESTAMP();
  DECLARE target_date DATE;

  ${incremental() 
    ? `SET target_date = ${dataform.projectConfig.vars.target_date 
        ? `DATE('${dataform.projectConfig.vars.target_date}')` 
        : `(SELECT latest_date FROM ${checkpoint_ref} WHERE table_name = '${bronze_source_table}')`
      };`
    : `SET target_date = NULL;`
  }

  ${when(!incremental(), `DROP TABLE IF EXISTS ${self()};`)}
}

WITH base_fact AS (
    SELECT
        ${func.generateHash(hash_elements.map(el => 
            el.includes("'") ? el : `CAST(${el} AS STRING)`
        ))} AS ${surrogate_key},
        ${fact_cols.join(",\n        ")}
    FROM ${source_ref}
    ${when(incremental(), `WHERE ${partition_col} = target_date`)}
)

SELECT
    ${when(incremental(), `COALESCE(target._ingested_at, run_time)`, `run_time`)} AS _ingested_at,
    run_time AS _updated_at,
    stg.*
FROM base_fact AS stg
${when(incremental(), 
  `LEFT JOIN ${self()} AS target ON stg.${surrogate_key} = target.${surrogate_key} AND target.${partition_col} = target_date`
)}