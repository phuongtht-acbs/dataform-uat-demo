js {
    // 1. THÔNG TIN NGUỒN TỪ BRONZE
    const source_table = "CORTASSET_EXT";
    const source_partition_col = "BUSINESS_DATE"; // Sử dụng BUSINESS_DATE làm cột phân vùng nguồn
    const unique_key_cols = ["SUB_ACCO_CD"];
    const dedupe_order_by = [
        { field: "InsertTime", sort: "DESC" },
        { field: "UPD_DATE_TIME", sort: "DESC" }
    ];
    
    // 2. ĐẶT TÊN PARTITION CHO BẢNG NÀY
    // business_date cho các bảng dữ liệu theo ngày làm việc/nghiệp vụ
    const target_partition_col = "business_date";
    
    // 3. NHÓM TRƯỜNG DỮ LIỆU
    const numeric_date_cols = [];
    
    const date_cols = [
        "BUSINESS_DATE"
    ];
    
    const boolean_cols = [
        { source: "DEL_CD", field_name: "is_deleted", true_value: 9 },
        { source: "IS_AUTO_ADVANCE", field_name: "is_auto_advance", true_value: 1 },
        { source: "IS_AUTO_MORTGAGE", field_name: "is_auto_mortgage", true_value: 1 }
    ];
    
    const string_cols = [
        "MARGIN_BROKER_CD", "REG_USER_ID", "UPD_USER_ID"
    ];
    
    const integer_cols = [
        "SUB_ACCO_CD"
    ];
    
    const numeric_cols = [
        "CASH_PENDING_BLOCK_AMT", "CASH_PENDING_PAY_AMT", "SEC_PENDING_BLOCK_AMT", 
        "SEC_MRG_PENDING_BLOCK_AMT", "ADVANCE_AVAIL", "REQUIRE_BOUGHT_UNPOST_AMT", 
        "MORTGAGE_AVAIL_AUTO", "MARGIN_LIMIT_GRP", "MARGIN_LIMIT"
    ];

    const float_cols = [
        "RETENTION_RATE", "TN_RATE", "MARGIN_RATE", "WARNING_RATE", 
        "CALL_RATE", "WITHDRAW_RATE"
    ];

    const cleaned_cols = [
        "REG_DATE_TIME", "UPD_DATE_TIME", "InsertDate", "InsertTime"
    ];

    //-----------------------------------------
    // 4. XỬ LÝ BIẾN
    
    // Kiểm tra xem target_partition_col đã tồn tại trong date_cols chưa
    const has_partition_col = date_cols.some(col => col.toLowerCase() === target_partition_col.toLowerCase());

    const output_cols = [
        "_hash_key",
        ...(has_partition_col ? [] : [target_partition_col]),
        ...date_cols,
        ...numeric_date_cols,
        ...string_cols, 
        ...integer_cols, 
        ...numeric_cols, 
        ...float_cols,
        ...cleaned_cols,
        ...boolean_cols.map(b => b.field_name)
    ].map(col => col.toLowerCase());
}

config {
    type: "incremental",
    schema: "silver",
    name: "stage_cortasset_ext",
    uniqueKey: ["_hash_key"],
    bigquery: {
        partitionBy: "business_date",
        updatePartitionFilter: "business_date = target_date"
    },
    description: "Bảng Staging chuẩn hóa thông tin tài sản mở rộng (CORTASSET_EXT). Sử dụng business_date làm cột phân vùng chính.",
    tags: ["silver", "subaccount", "daily"]
}

pre_operations {
  DECLARE run_time TIMESTAMP DEFAULT CURRENT_TIMESTAMP();
  DECLARE target_date DATE;
  SET target_date = (
    SELECT 
      ${dataform.projectConfig.vars.target_date 
        ? `DATE('${dataform.projectConfig.vars.target_date}')` 
        : `MAX(${source_partition_col}) FROM ${ref("bronze", source_table)}`
      }
  );
}

WITH staging_data AS (
    SELECT
    ${[
        // Xác định key để join và partition field (nếu chưa có)
        `${func.generateHash(unique_key_cols.map(c => `CAST(${c} AS STRING)`))} AS _hash_key`,
        ...(has_partition_col ? [] : [`${func.cleanNullDate(source_partition_col)} AS ${target_partition_col.toLowerCase()}`]),

        // Clean dữ liệu
        ...date_cols.map(col => `${func.cleanNullDate(col)} AS ${col.toLowerCase()}`),
        ...numeric_date_cols.map(col => `${func.parseNumericDate(col)} AS ${col.toLowerCase()}`),
        ...string_cols.map(col => `${func.cleanNullString(col)} AS ${col.toLowerCase()}`),
        ...integer_cols.map(col => `CAST(${col} AS INT64) AS ${col.toLowerCase()}`),
        ...numeric_cols.map(col => `CAST(${col} AS NUMERIC) AS ${col.toLowerCase()}`),
        ...float_cols.map(col => `CAST(${col} AS FLOAT64) AS ${col.toLowerCase()}`),
        ...boolean_cols.map(b => `CAST(${b.source} AS INT64) = ${b.true_value} AS ${b.field_name}`),
        ...cleaned_cols.map(col => `${col} AS ${col.toLowerCase()}`)
    ].join(",\n        ")}

    FROM ${ref("bronze", source_table)}
    WHERE ${source_partition_col} = target_date
    
    QUALIFY ROW_NUMBER() OVER (
        PARTITION BY ${unique_key_cols.join(", ")} 
        ORDER BY ${dedupe_order_by.map(o => `${o.field} ${o.sort}`).join(", ")}
    ) = 1
)

SELECT
    ${when(incremental(), `COALESCE(target._ingested_at, run_time)`, `run_time`)} AS _ingested_at,
    run_time AS _updated_at,
    ${output_cols.map(col => `stg.${col}`).join(",\n    ")}
FROM staging_data AS stg
${when(incremental(), 
  `LEFT JOIN ${self()} AS target ON stg._hash_key = target._hash_key AND target.${target_partition_col} = target_date`
)}