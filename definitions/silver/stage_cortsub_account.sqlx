js {
    // 1. THÔNG TIN NGUỒN TỪ BRONZE
    const source_table = "CORTSUB_ACCOUNT";
    const source_partition_col = "InsertDate";
    const unique_key_cols = ["SUB_ACCO_CD"];
    const dedupe_order_by = [
        { field: "InsertTime", sort: "DESC" },
        { field: "UPD_DATE_TIME", sort: "DESC" }
    ];
    
    // 2. ĐẶT TÊN PARTITION CHO BẢNG NÀY
    const target_partition_col = "snapshot_date";
    
    // 3. NHÓM TRƯỜNG DỮ LIỆU
    const numeric_date_cols = [
        "OPEN_DATE", "CLOSE_DATE", "REOPEN_DATE"
    ];
    
    const date_cols = [];
    
    const boolean_cols = [
        { source: "DEL_CD", field_name: "is_deleted", true_value: 9 }
    ];
    
    const string_cols = [
        "CURR_CD", "SUB_ACCO_NO", "BANK_CD", "BANK_BRANCH_CD", 
        "BANK_ACCO_NUMBER", "BANK_ACCO_NAME", "BANK_ACCO_ID_NO", 
        "CONTRACT_NO", "BROKER_CD", "TRADE_ACCO_NO", "SOURCE_CD", 
        "SOURCE_SNAME", "REMARKS", "REG_USER_ID", "UPD_USER_ID"
    ];
    
    const integer_cols = [
        "SUB_ACCO_CD", "CUST_CD", "ALGOS_TYPE", "ACCO_TYPE", "TYPE_FLG", 
        "NOT_UPDATE_BY_CUST", "BANK_FLG", "SOURCE_CHANNEL", "ACCO_STS", 
        "ACCO_FLG", "STATUS"
    ];
    
    const numeric_cols = [];
    const float_cols = [];

    const cleaned_cols = [
        "REG_DATE_TIME", "UPD_DATE_TIME", "InsertTime", "InsertDate"
    ];

    //-----------------------------------------
    // 4. XỬ LÝ BIẾN
    
    const has_partition_col = date_cols.some(col => col.toLowerCase() === target_partition_col.toLowerCase());

    const output_cols = [
        "_hash_key",
        ...(has_partition_col ? [] : [target_partition_col]),
        ...date_cols,
        ...numeric_date_cols,
        ...string_cols, 
        ...integer_cols, 
        ...numeric_cols, 
        ...float_cols,
        ...cleaned_cols,
        ...boolean_cols.map(b => b.field_name)
    ].map(col => col.toLowerCase());
}

config {
    type: "incremental",
    schema: "silver",
    name: "stage_cortsub_account",
    uniqueKey: ["_hash_key"],
    bigquery: {
        partitionBy: "snapshot_date",
        updatePartitionFilter: "snapshot_date = target_date"
    },
    description: "Bảng Staging chuẩn hóa thông tin tiểu khoản (subAccount) từ hệ thống Core (CORTSUB_ACCOUNT). Thực hiện làm sạch dữ liệu chuỗi, xử lý ngày tháng và loại bỏ trùng lặp.",
    tags: ["silver", "stage", "subaccount", "daily"],
    columns: {
        // Audit & Keys
        _hash_key: "Khóa chính (Surrogate Key) sinh ra từ hash của SUB_ACCO_CD",
        _ingested_at: "Thời điểm bản ghi lần đầu được đưa vào hệ thống",
        _updated_at: "Thời điểm bản ghi được cập nhật mới nhất trong Silver",
        snapshot_date: "Ngày snapshot dữ liệu (ánh xạ từ InsertDate)",

        // Keys & Identifiers
        sub_acco_cd: "Tự động tăng toàn bảng (Dùng để deduplicate)",
        is_deleted: "Dữ liệu đã xóa hay chưa",
        cust_cd: "Mã định danh khách hàng chủ sở hữu",

        // Classification & Types
        acco_type: "1-CASH (01-->09); 2-MARGIN (10-->19); 3-BANKING (20-->29); 4-SHORTSALE (30-->39); 5-TK QUỸ MỞ (40-->49); 6-DERIVATIVES (50-->59); 7-ORTHER (60 --> 69); 9-ALGOS (90 --> 99)",
        algos_type: "Loại tiểu khoản Algos (CopyTrade, Chiến thuật)",
        type_flg: "Mô hình tiểu khoản (TK thường, TK tổng OMS, Leader/Copier...)",
        curr_cd: "Mã loại tiền tệ",
        sub_acco_no: "Số hiệu tiểu khoản (Ví dụ: 014C123456.XY)",

        // Banking Details
        bank_cd: "Mã ngân hàng (Chỉ có ý nghĩa khi ACCO_TYPE=3, 6)",
        bank_branch_cd: "Mã chi nhánh ngân hàng (Chỉ có ý nghĩa khi ACCO_TYPE=3, 6)",
        bank_acco_number: "Số tài khoản ngân hàng (Chỉ có ý nghĩa khi ACCO_TYPE=3, 6)",
        bank_acco_name: "Tên chủ tài khoản ngân hàng (Chỉ có ý nghĩa khi ACCO_TYPE=3)",
        bank_acco_id_no: "Số giấy tờ định danh chủ tài khoản ngân hàng (Chỉ có ý nghĩa khi ACCO_TYPE=3)",
        bank_flg: "Cờ phong tỏa/đồng bộ số dư ngân hàng (Mặc định: 1)",

        // Flags & Logic
        not_update_by_cust: "Cờ chặn khách hàng cập nhật thông tin tiểu khoản",
        contract_no: "Số hợp đồng liên kết",
        source_channel: "Kênh tạo dữ liệu (1: Back Office; 2: Front Office; 3: Floor Trading)",
        broker_cd: "Mã nhân viên môi giới quản lý",
        acco_sts: "Trạng thái tài khoản (1-Open, 2-Close)",
        acco_flg: "Cờ tài khoản mặc định (0: Không mặc định, 1: Mặc định)",
        trade_acco_no: "Mã số tài khoản giao dịch (Chỉ áp dụng cho loại ACCO_TYPE = 6)",
        status: "Trạng thái phê duyệt (0-Pending, 1-Approved)",

        // Khác
        source_cd: "Nguồn tiểu khoản (CASH, LOCAL, BANK_CD, SHORTSALE, DERIVATIVES...)",
        source_sname: "Tên chi tiết nguồn tiểu khoản",
        open_date: "Ngày mở tiểu khoản",
        close_date: "Ngày đóng tiểu khoản",
        reopen_date: "Ngày mở lại tiểu khoản đã đóng",
        remarks: "Ghi chú bổ sung",

        // Audit từ nguồn và snapshot
        reg_date_time: "Thời điểm đăng ký bản ghi",
        reg_user_id: "Người tạo bản ghi",
        upd_date_time: "Thời điểm cập nhật bản ghi",
        upd_user_id: "Người cập nhật bản ghi",
        insertdate: "Ngày snapshot dữ liệu",
        inserttime: "Thời điểm snapshot dữ liệu",
    }
}

pre_operations {
  -- 1. Khai báo biến
  DECLARE run_time TIMESTAMP DEFAULT CURRENT_TIMESTAMP();
  DECLARE target_date DATE;
  DECLARE start_date DATE;
  DECLARE end_date DATE;

  -- 2. Logic xác định thời gian dựa trên loại hình chạy
  ${incremental() 
    ? `SET target_date = ${dataform.projectConfig.vars.target_date 
        ? `DATE('${dataform.projectConfig.vars.target_date}')` 
        : `(SELECT MAX(${source_partition_col}) FROM ${ref("bronze", source_table)})`
      };`
    : `SET start_date = ${dataform.projectConfig.vars.start_date 
        ? `DATE('${dataform.projectConfig.vars.start_date}')` 
        : `(SELECT MIN(${source_partition_col}) FROM ${ref("bronze", source_table)})`
      };
      SET end_date = ${dataform.projectConfig.vars.end_date 
        ? `DATE('${dataform.projectConfig.vars.end_date}')` 
        : `(SELECT MAX(${source_partition_col}) FROM ${ref("bronze", source_table)})`
      };
      SET target_date = NULL; -- Đảm bảo updatePartitionFilter không bị lỗi khi biên dịch`
  }

  -- 3. Drop table khi Full Refresh
  ${when(!incremental(), `DROP TABLE IF EXISTS ${self()};`)}
}

WITH staging_data AS (
    SELECT
    ${[
        // Xác định key để join và partition field (nếu chưa có)
        `${func.generateHash(unique_key_cols.map(c => `CAST(${c} AS STRING)`))} AS _hash_key`,
        ...(has_partition_col ? [] : [`${func.cleanNullDate(source_partition_col)} AS ${target_partition_col.toLowerCase()}`]),

        // Clean dữ liệu
        ...date_cols.map(col => `${func.cleanNullDate(col)} AS ${col.toLowerCase()}`),
        ...numeric_date_cols.map(col => `${func.parseNumericDate(col)} AS ${col.toLowerCase()}`),
        ...string_cols.map(col => `${func.cleanNullString(col)} AS ${col.toLowerCase()}`),
        ...integer_cols.map(col => `CAST(${col} AS INT64) AS ${col.toLowerCase()}`),
        ...numeric_cols.map(col => `CAST(${col} AS NUMERIC) AS ${col.toLowerCase()}`),
        ...float_cols.map(col => `CAST(${col} AS FLOAT64) AS ${col.toLowerCase()}`),
        ...boolean_cols.map(b => `CAST(${b.source} AS INT64) = ${b.true_value} AS ${b.field_name}`),
        ...cleaned_cols.map(col => `${col} AS ${col.toLowerCase()}`)
    ].join(",\n        ")}

    FROM ${ref("bronze", source_table)}
    WHERE
        ${incremental() 
          ? `${source_partition_col} = target_date` 
          : `${source_partition_col} BETWEEN start_date AND end_date`
        }
    -- Deduplicate dựa trên key duy nhất
    QUALIFY ROW_NUMBER() OVER (
        PARTITION BY ${unique_key_cols.join(", ")} 
        ORDER BY ${dedupe_order_by.map(o => `${o.field} ${o.sort}`).join(", ")}
    ) = 1
)

SELECT
    ${when(incremental(), `COALESCE(target._ingested_at, run_time)`, `run_time`)} AS _ingested_at,
    run_time AS _updated_at,
    ${output_cols.map(col => `stg.${col}`).join(",\n    ")}
FROM staging_data AS stg
${when(incremental(), 
  `LEFT JOIN ${self()} AS target ON stg._hash_key = target._hash_key AND target.${target_partition_col} = target_date`
)}