config {
    type: "incremental",
    schema: "silver",
    name: "stage_cortsub_account",
    description: "Bảng Staging chuẩn hóa thông tin tiểu khoản (subAccount) từ hệ thống Core (CORTSUB_ACCOUNT). Thực hiện làm sạch dữ liệu chuỗi, xử lý ngày tháng và loại bỏ trùng lặp theo sub_acco_cd.",
    tags: ["silver", "subaccount", "daily"],
    uniqueKey: ["sub_acco_cd", "insert_date"],
    bigquery: {
        partitionBy: "insert_date",
    },
    columns: {
        // Audit luồng Dataform
        _ingested_at: "Thời điểm bản ghi lần đầu được đưa vào hệ thống",
        _updated_at: "Thời điểm bản ghi được cập nhật mới nhất trong Silver",

        // Keys & Identifiers
        sub_acco_cd: "Tự động tăng toàn bảng (Dùng để deduplicate)",
        is_deleted: "Dữ liệu đã xóa hay chưa",
        cust_cd: "Mã định danh khách hàng chủ sở hữu",

        // Classification & Types
        acco_type: "1-CASH (01-->09); 2-MARGIN (10-->19); 3-BANKING (20-->29); 4-SHORTSALE (30-->39); 5-TK QUỸ MỞ (40-->49); 6-DERIVATIVES (50-->59); 7-ORTHER (60 --> 69); 9-ALGOS (90 --> 99)",
        algos_type: "Loại tiểu khoản Algos (CopyTrade, Chiến thuật)",
        type_flg: "Mô hình tiểu khoản (TK thường, TK tổng OMS, Leader/Copier...)",
        curr_cd: "Mã loại tiền tệ",
        sub_acco_no: "Số hiệu tiểu khoản (Ví dụ: 014C123456.XY)",

        // Banking Details
        bank_cd: "Mã ngân hàng (Chỉ có ý nghĩa khi ACCO_TYPE=3, 6)",
        bank_branch_cd: "Mã chi nhánh ngân hàng (Chỉ có ý nghĩa khi ACCO_TYPE=3, 6)",
        bank_acco_number: "Số tài khoản ngân hàng (Chỉ có ý nghĩa khi ACCO_TYPE=3, 6)",
        bank_acco_name: "Tên chủ tài khoản ngân hàng (Chỉ có ý nghĩa khi ACCO_TYPE=3)",
        bank_acco_id_no: "Số giấy tờ định danh chủ tài khoản ngân hàng (Chỉ có ý nghĩa khi ACCO_TYPE=3)",
        bank_flg: "Cờ phong tỏa/đồng bộ số dư ngân hàng (Mặc định: 1)",

        // Flags & Logic
        not_update_by_cust: "Cờ chặn khách hàng cập nhật thông tin tiểu khoản",
        contract_no: "Số hợp đồng liên kết",
        source_channel: "Kênh tạo dữ liệu (1: Back Office; 2: Front Office; 3: Floor Trading)",
        broker_cd: "Mã nhân viên môi giới quản lý",
        acco_sts: "Trạng thái tài khoản (1-Open, 2-Close)",
        acco_flg: "Cờ tài khoản mặc định (0: Không mặc định, 1: Mặc định)",
        trade_acco_no: "Mã số tài khoản giao dịch (Chỉ áp dụng cho loại ACCO_TYPE = 6)",
        status: "Trạng thái phê duyệt (0-Pending, 1-Approved)",

        // Khác
        source_cd: "Nguồn tiểu khoản (CASH, LOCAL, BANK_CD, SHORTSALE, DERIVATIVES...)",
        source_sname: "Tên chi tiết nguồn tiểu khoản",
        open_date: "Ngày mở tiểu khoản",
        close_date: "Ngày đóng tiểu khoản",
        reopen_date: "Ngày mở lại tiểu khoản đã đóng",
        remarks: "Ghi chú bổ sung",

        // Audit từ nguồn và snapshot
        reg_date_time: "Thời điểm đăng ký bản ghi",
        reg_user_id: "Người tạo bản ghi",
        upd_date_time: "Thời điểm cập nhật bản ghi",
        upd_user_id: "Người cập nhật bản ghi",
        insert_date: "Ngày snapshot dữ liệu",
        insert_time: "Thời điểm snapshot dữ liệu"
    }
}

pre_operations {
  -- 1. Xác định target_date
  DECLARE target_date DATE;
  SET target_date = (
    ${dataform.projectConfig.vars.target_date 
      ? `DATE('${dataform.projectConfig.vars.target_date}')` 
      : `(SELECT MAX(InsertDate) FROM ${ref("bronze", "CORTSUB_ACCOUNT")})`
    }
  );
  -- 2. Xác định thời gian chạy
  DECLARE run_time TIMESTAMP DEFAULT CURRENT_TIMESTAMP();
}

WITH staging_data AS (
    SELECT
        -- Identifiers and Numeric Statuses
        CAST(SUB_ACCO_CD AS INT64) AS sub_acco_cd,
        CAST(DEL_CD AS INT64) = 9 AS is_deleted,
        CAST(CUST_CD AS INT64) AS cust_cd,
        CAST(ALGOS_TYPE AS INT64) AS algos_type,
        CAST(ACCO_TYPE AS INT64) AS acco_type,
        CAST(TYPE_FLG AS INT64) AS type_flg,
        CAST(NOT_UPDATE_BY_CUST AS INT64) AS not_update_by_cust,
        CAST(BANK_FLG AS INT64) AS bank_flg,
        CAST(SOURCE_CHANNEL AS INT64) AS source_channel,
        CAST(ACCO_STS AS INT64) AS acco_sts,
        CAST(ACCO_FLG AS INT64) AS acco_flg,
        CAST(STATUS AS INT64) AS status,

        -- String Cleaning
        ${func.clean_null_string("CURR_CD")} AS curr_cd,
        ${func.clean_null_string("SUB_ACCO_NO")} AS sub_acco_no,
        ${func.clean_null_string("BANK_CD")} AS bank_cd,
        ${func.clean_null_string("BANK_BRANCH_CD")} AS bank_branch_cd,
        ${func.clean_null_string("BANK_ACCO_NUMBER")} AS bank_acco_number,
        ${func.clean_null_string("BANK_ACCO_NAME")} AS bank_acco_name,
        ${func.clean_null_string("BANK_ACCO_ID_NO")} AS bank_acco_id_no,
        ${func.clean_null_string("CONTRACT_NO")} AS contract_no,
        ${func.clean_null_string("BROKER_CD")} AS broker_cd,
        ${func.clean_null_string("TRADE_ACCO_NO")} AS trade_acco_no,
        ${func.clean_null_string("SOURCE_CD")} AS source_cd,
        ${func.clean_null_string("SOURCE_SNAME")} AS source_sname,
        ${func.clean_null_string("REMARKS")} AS remarks,

        -- Date Parsing
        ${func.parse_date("OPEN_DATE")} AS open_date,
        ${func.parse_date("CLOSE_DATE")} AS close_date,
        ${func.parse_date("REOPEN_DATE")} AS reopen_date,

        -- Operational & Snapshot Metadata
        REG_DATE_TIME AS reg_date_time,
        ${func.clean_null_string("REG_USER_ID")} AS reg_user_id,
        UPD_DATE_TIME AS upd_date_time,
        ${func.clean_null_string("UPD_USER_ID")} AS upd_user_id,
        InsertDate AS insert_date,
        InsertTime AS insert_time
    FROM ${ref("bronze", "CORTSUB_ACCOUNT")}
    WHERE InsertDate = target_date
    QUALIFY ROW_NUMBER() OVER ( PARTITION BY SUB_ACCO_CD ORDER BY InsertTime DESC, UPD_DATE_TIME DESC) = 1
)

SELECT
    ${when(incremental(), `COALESCE(target._ingested_at, run_time)`, `run_time`)} AS _ingested_at,
    run_time AS _updated_at,
    stg.*,
FROM staging_data AS stg
-- Chỉ join với chính nó khi đang chạy incremental
${when(incremental(), 
  `LEFT JOIN ${self()} AS target 
    ON stg.sub_acco_cd = target.sub_acco_cd AND stg.insert_date = target.insert_date`
)}