js {
  // 1. cortsub_account columns
  const sub_account_cols = [
    "sub_acco_cd", "sub_acco_no", "is_deleted", "cust_cd", "acco_type", "algos_type",
    "type_flg", "curr_cd", "bank_cd", "bank_branch_cd", "bank_acco_number",
    "bank_acco_name", "bank_acco_id_no", "bank_flg", "not_update_by_cust",
    "contract_no", "source_channel", "broker_cd", "acco_sts", "acco_flg",
    "trade_acco_no", "status", "source_cd", "source_sname", "open_date",
    "close_date", "reopen_date", "remarks", "reg_date_time", "reg_user_id",
    "upd_date_time", "upd_user_id"
  ];

  // 2. cortasset_ext columns
  const asset_ext_cols = [
    "is_auto_advance", "is_auto_mortgage", "retention_rate", "warning_rate",
    "tn_rate", "call_rate", "withdraw_rate", "margin_limit_grp", "margin_limit"
  ];

  // 3. cortasset columns
  const asset_cols = ['cust_group_id']
}

config {
    type: "incremental",
    schema: "silver",
    name: "stage_subaccount",
    uniqueKey: ["_hash_key"],
    bigquery: {
        partitionBy: "snapshot_date",
        updatePartitionFilter: "snapshot_date = target_date"
    },
    description: "Consolidated Subaccount staging. Uses Range 'As-Of' logic to join core snapshots efficiently without Cartesian explosion.",
    tags: ["silver", "stage", "subaccount", "daily"]
}

pre_operations {
  DECLARE run_time TIMESTAMP DEFAULT CURRENT_TIMESTAMP();
  DECLARE target_date DATE;
  DECLARE start_date DATE;
  DECLARE end_date DATE;

  -- Determine target date or date range based on incremental()
  ${incremental() 
    ? 
    `SET target_date = ${dataform.projectConfig.vars.target_date 
        ? `DATE('${dataform.projectConfig.vars.target_date}')` 
        : `(SELECT MAX(snapshot_date) FROM ${ref("silver", "stage_cortsub_account")})`
      };`
    : 
    `SET start_date = ${dataform.projectConfig.vars.start_date 
        ? `DATE('${dataform.projectConfig.vars.start_date}')` 
        : `(SELECT MIN(snapshot_date) FROM ${ref("silver", "stage_cortsub_account")})`
      };
      SET end_date = ${dataform.projectConfig.vars.end_date 
        ? `DATE('${dataform.projectConfig.vars.end_date}')` 
        : `(SELECT MAX(snapshot_date) FROM ${ref("silver", "stage_cortsub_account")})`
      };
      SET target_date = NULL;`
  }

  -- Drop table during Full Refresh
  ${when(!incremental(), `DROP TABLE IF EXISTS ${self()};`)}
}

WITH base_sub_account AS (
    SELECT 
        * FROM ${ref("silver", "stage_cortsub_account")}
    WHERE 
        ${incremental() 
          ? `snapshot_date = target_date` 
          : `snapshot_date BETWEEN start_date AND end_date`
        }
),

asset_ext_ranges AS (
    SELECT 
        *,
        -- 1. Create a boundary date for the range join
        LEAD(business_date) OVER (PARTITION BY sub_acco_cd ORDER BY business_date) AS next_business_date
    FROM ${ref("silver", "stage_cortasset_ext")}
    -- We load history up to the latest processing date to ensure we have the context
    WHERE business_date <= COALESCE(target_date, end_date)
),

asset_ranges AS (
    SELECT 
        *,
        -- 1. Create a boundary date for the range join
        LEAD(business_date) OVER (PARTITION BY sub_acco_cd ORDER BY business_date) AS next_business_date
    FROM ${ref("silver", "stage_cortasset")}
    WHERE business_date <= COALESCE(target_date, end_date)
)

SELECT
    ${when(incremental(), `COALESCE(target._ingested_at, run_time)`, `run_time`)} AS _ingested_at,
    run_time AS _updated_at,
    s.snapshot_date,
    s._hash_key,
    ${sub_account_cols.map(c => `s.${c}`).join(",\n    ")},
    ${asset_ext_cols.map(c => `ae.${c}`).join(",\n    ")},
    ${asset_cols.map(c => `a.${c}`).join(",\n    ")}
FROM base_sub_account AS s

-- 2. Range Joins completely prevent the Cartesian explosion
LEFT JOIN asset_ext_ranges AS ae 
    ON s.sub_acco_cd = ae.sub_acco_cd 
    AND s.snapshot_date >= ae.business_date 
    AND (s.snapshot_date < ae.next_business_date OR ae.next_business_date IS NULL)

LEFT JOIN asset_ranges AS a 
    ON s.sub_acco_cd = a.sub_acco_cd 
    AND s.snapshot_date >= a.business_date 
    AND (s.snapshot_date < a.next_business_date OR a.next_business_date IS NULL)

${when(incremental(),
  `LEFT JOIN ${self()} AS target ON s._hash_key = target._hash_key AND target.snapshot_date = target_date`
)}

-- 3. Keep QUALIFY purely as a safety net in case the source tables have duplicate records on the exact same business_date
QUALIFY ROW_NUMBER() OVER (
  PARTITION BY s._hash_key, s.snapshot_date 
  ORDER BY ae.business_date DESC, a.business_date DESC
) = 1