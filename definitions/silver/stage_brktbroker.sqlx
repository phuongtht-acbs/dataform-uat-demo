config {
    type: "incremental",
    schema: "silver",
    name: "stage_brktbroker",
    description: "Bảng Staging lưu trữ lịch sử snapshot thông tin môi giới. Dữ liệu được chuẩn hóa, parse ngày tháng và bảo toàn vết ingestion.",
    tags: ["silver", "broker", "daily"],
    uniqueKey: ["broker_cd", "insert_date"],
    bigquery: {
        partitionBy: "insert_date",
    },
    columns: {
        // Audit luồng Dataform
        _ingested_at: "Thời điểm bản ghi lần đầu được đưa vào hệ thống",
        _updated_at: "Thời điểm bản ghi được cập nhật mới nhất trong Silver",

        // Primary Identifiers
        broker_cd: "Mã nhân viên môi giới",
        is_deleted: "Dữ liệu đã xóa hay chưa",
        parent_broker_cd: "Mã môi giới quản lý cấp trên (Mặc định: null)",
        
        // Personal Information
        family_name: "Họ nhân viên",
        given_name: "Tên nhân viên",
        mobile_no: "Số điện thoại di động",
        email_adrs: "Địa chỉ Email",
        adrs_1: "Địa chỉ thường trú 1",
        adrs_2: "Địa chỉ thường trú 2",
        
        // Identification
        approval_cd: "Loại giấy tờ định danh (1: ID Card, 2: Passport, 3: Driving Licence, 4: Business Certificate, 9: Other)",
        id_number: "Số CMND/CCCD/Hộ chiếu",
        issue_location: "Nơi cấp giấy tờ định danh",
        issue_date: "Ngày cấp giấy tờ định danh",
        expire_date: "Ngày hết hạn giấy tờ định danh",
        
        // Account & Employment Details
        user_id: "Tài khoản người dùng trên hệ thống (UserID)",
        transaction_cd: "Mã điểm giao dịch",
        acco_begin_date: "Ngày bắt đầu làm việc",
        acco_end_date: "Ngày kết thúc làm việc/Ngày hết hạn",
        employee_type: "Phân loại nhân viên (1: Thử việc, 2: Chính thức, 3: CTV)",
        ctv_corp_id: "ID mã quản lý tổ chức CTV (Áp dụng cho loại EMPLOYEE_TYPE = 3)",
        acco_sts: "Trạng thái tài khoản môi giới",
        
        // Professional Qualifications
        exc_begin_date: "Ngày xét kinh nghiệm KPI",
        cert_begin_date: "Ngày cấp chứng chỉ hành nghề",
        business_type: "Loại hình kinh doanh (Lưu ID dạng chuỗi: 1, 2)",
        broker_type_id: "Phân hệ môi giới",
        
        // Compensation & Tax
        depend_number: "Số người phụ thuộc giảm trừ gia cảnh",
        insurance_salary: "Mức lương đóng bảo hiểm",
        basic_salary: "Mức lương cơ bản",
        end_basic_salary_month: "Tháng kết thúc nhận lương cơ bản (YYYYMM)",
        
        // Technical Metadata
        remarks: "Ghi chú bổ sung",
        reg_date_time: "Thời gian đăng ký hệ thống",
        reg_user_id: "Mã người dùng đăng ký",
        upd_date_time: "Thời gian cập nhật hệ thống",
        upd_user_id: "Mã người dùng cập nhật",
        insert_date: "Ngày snapshot dữ liệu từ nguồn",
        insert_time: "Thời điểm snapshot dữ liệu"
    }
}

pre_operations {
  -- 1. Xác định thời gian chạy
  DECLARE run_time TIMESTAMP DEFAULT CURRENT_TIMESTAMP();
  -- 2. Xác định target_date
  DECLARE target_date DATE;
  SET target_date = (
    ${dataform.projectConfig.vars.target_date 
      ? `DATE('${dataform.projectConfig.vars.target_date}')` 
      : `(SELECT MAX(TRADE_DATE) FROM ${ref("bronze", "BRKTBROKER")})`
    }
  );
}

WITH staging_data AS (
    SELECT
        -- 1. Identifiers
        ${func.cleanNullString("BROKER_CD")} AS broker_cd,
        CAST(DEL_CD AS INT64) = 9 AS is_deleted,

        -- 2. Numeric Status and ID Codes
        CAST(APPROVAL_CD AS INT64) AS approval_cd,
        CAST(EMPLOYEE_TYPE AS INT64) AS employee_type,
        CAST(CTV_CORP_ID AS INT64) AS ctv_corp_id,
        CAST(DEPEND_NUMBER AS INT64) AS depend_number,
        CAST(END_BASIC_SALARY_MONTH AS INT64) AS end_basic_salary_month,
        CAST(BROKER_TYPE_ID AS INT64) AS broker_type_id,
        CAST(ACCO_STS AS INT64) AS acco_sts,

        -- 3. Financial Values
        CAST(INSURANCE_SALARY AS FLOAT64) AS insurance_salary,
        CAST(BASIC_SALARY AS FLOAT64) AS basic_salary,

        -- 4. String Cleaning
        ${func.cleanNullString("PARENT_BROKER_CD")} AS parent_broker_cd,
        ${func.cleanNullString("FAMILY_NAME")} AS family_name,
        ${func.cleanNullString("GIVEN_NAME")} AS given_name,
        ${func.cleanNullString("MOBILE_NO")} AS mobile_no,
        ${func.cleanNullString("EMAIL_ADRS")} AS email_adrs,
        ${func.cleanNullString("ADRS_1")} AS adrs_1,
        ${func.cleanNullString("ADRS_2")} AS adrs_2,
        ${func.cleanNullString("ID_NUMBER")} AS id_number,
        ${func.cleanNullString("ISSUE_LOCATION")} AS issue_location,
        ${func.cleanNullString("USER_ID")} AS user_id,
        ${func.cleanNullString("TRANSACTION_CD")} AS transaction_cd,
        ${func.cleanNullString("BUSINESS_TYPE")} AS business_type,
        ${func.cleanNullString("REMARKS")} AS remarks,

        -- 5. Date Parsing
        ${func.parseDate("ISSUE_DATE")} AS issue_date,
        ${func.parseDate("EXPIRE_DATE")} AS expire_date,
        ${func.parseDate("ACCO_BEGIN_DATE")} AS acco_begin_date,
        ${func.parseDate("ACCO_END_DATE")} AS acco_end_date,
        ${func.parseDate("EXC_BEGIN_DATE")} AS exc_begin_date,
        ${func.parseDate("CERT_BEGIN_DATE")} AS cert_begin_date,

        -- 6. Operational & Snapshot Metadata
        REG_DATE_TIME AS reg_date_time,
        ${func.cleanNullString("REG_USER_ID")} AS reg_user_id,
        UPD_DATE_TIME AS upd_date_time,
        ${func.cleanNullString("UPD_USER_ID")} AS upd_user_id,
        InsertDate AS insert_date,
        InsertTime AS insert_time
    FROM ${ref("bronze", "BRKTBROKER")}
    WHERE TRADE_DATE = target_date
    QUALIFY ROW_NUMBER() OVER (
        PARTITION BY BROKER_CD 
        ORDER BY InsertTime DESC, UPD_DATE_TIME DESC
    ) = 1
)

SELECT
    ${when(incremental(), `COALESCE(target._ingested_at, run_time)`, `run_time`)} AS _ingested_at,
    run_time AS _updated_at,
    stg.*,
FROM staging_data AS stg
${when(incremental(), 
  `LEFT JOIN ${self()} AS target 
    ON stg.broker_cd = target.broker_cd AND stg.insert_date = target.insert_date`
)}