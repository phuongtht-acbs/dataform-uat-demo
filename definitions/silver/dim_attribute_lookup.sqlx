config {
    type: "view",
    schema: "silver",
    name: "dim_attribute_lookup",
    description: "Bảng tra cứu mã và tên thuộc tính tập trung, được trích xuất từ tài liệu Excel.",
    tags: ["silver", "dimension", "lookup", "daily"]
}


js {
  /**
   * Consolidated Metadata from all Excel documentation.
   * New categories added: CORTCASH_MOVEMENT (ACCOUNT_TYPE, TRADE_TYPE, STATUS).
   */
  const excel_metadata = {
    // --- CORTCUSTOMER Metadata ---
    "CORTCUSTOMER__CUST_TYPE": { 1: "Cá nhân", 2: "Tổ chức" },
    "CORTCUSTOMER__FOREIGN_TYPE": { 1: "Trong nước", 2: "Nước ngoài" },
    "CORTCUSTOMER__SEX": { 0: "Không", 1: "Nam", 2: "Nữ" },
    "CORTCUSTOMER__ACCO_STS": { 1: "New", 2: "Sleeping", 3: "Active", 4: "Closed" },
    "CORTCUSTOMER__VSD_STATUS": { 0: "Chưa gửi", 1: "Đã gửi", 2: "Xác nhận", 3: "Từ chối bởi VSD", 4: "Từ chối bởi Gate" },
    "CORTCUSTOMER__CONTRACT_STATUS": { 0: "Chưa hoàn thiện", 1: "Đã hoàn thiện", 2: "Ngừng GD tạm thời", 3: "Chưa hoàn thiện & TK rỗng" },
    "CORTCUSTOMER__APPROVAL_CD": { 1: "CMND", 2: "Passport", 3: "GPKD", 8: "CCCD" },
    "CORTCUSTOMER__SRC_CHANNEL": { 1: "Back office", 2: "Online", 3: "Floor", 9: "Tel/CC" },

    // --- CORTSUB_ACCOUNT Metadata ---
    "CORTSUB_ACCOUNT__ACCO_TYPE": { 
      1: "CASH", 2: "MARGIN", 3: "BANKING", 4: "SHORTSALE", 
      5: "TK QUỸ MỞ", 6: "DERIVATIVES", 7: "OTHER", 9: "ALGOS" 
    },
    "CORTSUB_ACCOUNT__ACCO_STS": { 1: "Open", 2: "Close" },
    "CORTSUB_ACCOUNT__ALGOS_TYPE": { 1: "CopyTrade", 2: "Chiến thuật" },
    "CORTSUB_ACCOUNT__STATUS": { 0: "Pending", 1: "Approved" },
    "CORTSUB_ACCOUNT__SOURCE_CHANNEL": { 1: "Back Office", 2: "Front Office", 3: "Floor Trading" },
    "CORTSUB_ACCOUNT__BANK_FLG": { 1: "Phong tỏa đầu ngày", 2: "Phong tỏa thủ công", 3: "Phong tỏa tự động", 4: "Đồng bộ số dư" },
    "CORTSUB_ACCOUNT__ACCO_FLG": { 0: "Không mặc định", 1: "Mặc định" },

    // --- BRKTBROKER Metadata ---
    "BRKTBROKER__APPROVAL_CD": { 1: "ID Card", 2: "Passport", 3: "Driving Licence", 4: "Business Certificate", 9: "Other" },
    "BRKTBROKER__ACCO_STS": { 1: "Open", 2: "Close" },
    "BRKTBROKER__EMPLOYEE_TYPE": { 1: "Thử việc", 2: "Chính thức", 3: "CTV" },

    // --- CORTCASH_MOVEMENT Metadata ---
    "CORTCASH_MOVEMENT__ACCOUNT_TYPE": { 1: "Cash", 2: "Margin" },
    "CORTCASH_MOVEMENT__TRADE_TYPE": { 1: "Debit", 2: "Credit" },
    "CORTCASH_MOVEMENT__STATUS": { 0: "Chưa duyệt", 1: "Đã duyệt", 9: "Đã hủy" },
  
    // --- MRGTDEBIT_CONTRACT Metadata ---
    "MRGTDEBIT_CONTRACT__DEBIT_TYPE": { 1: "Margin", 2: "TN" },
    "MRGTDEBIT_CONTRACT__CONTRACT_TYPE": { 0: "New", 1: "Hợp đồng đáo hạn" },
    "MRGTDEBIT_CONTRACT__LOAN_TYPE": { 0: "Giải ngân mua", 1: "Giải ngân đặc biệt", 2: "Giải ngân trả lãi", 3: "Giải ngân rút tiền", 4: "Giải ngân ký quỹ PS" },
    "MRGTDEBIT_CONTRACT__DEBTTYPE_ID": { 0: "Giải ngân mua", 1: "Giải ngân đặc biệt", 2: "Giải ngân trả lãi", 3: "Giải ngân rút tiền" },
    "MRGTDEBIT_CONTRACT__STATUS": { 0: "Chưa duyệt", 1: "Đã duyệt", 2: "Đã kết thúc", 3: "Gia hạn chờ duyệt", 5: "Đã tất toán", 9: "Đã huỷ" },
    "MRGTDEBIT_CONTRACT__INT_TYPE": { 1: "Là lãi cố định", 2: "Lãi bậc thang theo tuổi nợ", 3: "Lãi bậc thang theo dư nợ" },
    "MRGTDEBIT_CONTRACT__CALUCATE": { 1: "Ngày", 2: "Tháng", 3: "Năm 360 ngày", 4: "Năm 365 ngày" },
    "MRGTDEBIT_CONTRACT__ROUND_TYPE": { 1: "Round", 2: "Round Up", 3: "Floor", 4: "Ceiling" },
    "MRGTDEBIT_CONTRACT__DECIMAL_POINT": { "-3": "Three Frac Point", "-2": "Two Frac Point", "-1": "One Frac Point", 0: "Đơn vị", 1: "Chục", 2: "Trăm", 3: "Nghìn" },
  // --- MSTTBRANCH / TRANSACTION Metadata ---
    "MSTTBRANCH__STATUS": { 1: "Opening", 2: "Closed" },
    "MSTTBRANCH__TRANSACTION_FLG": { 0: "Hội sở", 1: "Chi nhánh", 2: "Điểm giao dịch", 3: "Phòng giao dịch" },
    "MSTTBRANCH__VSD_BRANCH": { 1: "Trụ sở chính VSD tại Hà Nội", 2: "Chi nhánh VSD tại TP.HCM" },
  // --- MSTTSECURITIES Metadata ---
    "MSTTSECURITIES__SEC_TYPE": {
      1: "Cổ phiếu", 
      2: "Chứng chỉ quỹ", 
      3: "Trái phiếu", 
      4: "Chứng chỉ quỹ ETF", 
      5: "Chứng quyền", 
      6: "Tín phiếu", 
      7: "Trái phiếu riêng lẻ" 
    },
    "MSTTSECURITIES__BOND_TYPE": { 
      1: "Trái phiếu chính phủ", 
      2: "Trái phiếu chính quyền địa phương", 
      3: "Trái phiếu doanh nghiệp", 
      4: "Trái phiếu CP bảo lãnh" 
    }
  };

  /**
   * Helper function to generate SQL rows.
   * Forces category to UPPERCASE and code to INT64.
   */
  const get_metadata_rows = (metadata) => {
    return Object.keys(metadata).flatMap(category =>
      Object.entries(metadata[category]).map(([code, name]) =>
        `SELECT '${category.toUpperCase()}' AS category, CAST(${code} AS INT64) AS attribute_code, '${name}' AS attribute_name`
      )
    ).join("\n  UNION ALL ");
  }
}

WITH raw_metadata AS (
  ${get_metadata_rows(excel_metadata)}
)

SELECT
  -- Generate a unique key for efficient joining
  ${func.generateHash(["category", "CAST(attribute_code AS STRING)"])} AS attribute_key,
  category,
  attribute_code,
  attribute_name,
  CURRENT_TIMESTAMP() AS _updated_at
FROM
  raw_metadata