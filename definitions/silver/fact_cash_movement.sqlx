config {
  // ===========================================================================
  // BƯỚC 1: Config metadata của file
  // ===========================================================================
  type: "view",
  schema: "silver",
  name: "fact_cash_movement",
  description: "View lịch sử giao dịch tiền của khách hàng từ hệ thống Core",
  tags: ["silver", "fact", "cash_movement", "view"]
}

js {
  // ============================================================================
  // BƯỚC 2. Điền thông tin về nguồn dữ liệu, key và độ chi tiết
  // ============================================================================
  const source_schema = "silver";                          // Dataset chứa bảng stage nguồn
  const source_table = "stage_cortcash_movement_history";  // Tên bảng stage nguồn

  // ============================================================================
  // BƯỚC 3. Điền các cột ở bảng stage mà cần có ở bảng view
  // ============================================================================
  const cols = [
    "business_date", "cash_movement_id", "allo_date", "ref_no", "is_deleted", "cust_cd", "cust_no", "sub_acco_cd", "sub_acco_no",
    "entry_date", "approvement_id", "group_category", "task_cd", "src_date", "src_no",
    "src_transaction_cd", "curr_cd", "begin_amount", "amount", "amount_type", "trade_type",
    "after_amount", "util_cd", "util_cash_id", "status", "transaction_cd",
    "internal_balance_code", "doc", "remarks", "memo"
  ];

  // ============================================================================
  // BƯỚC 4: Một số biến hỗ trợ logic (không cần đụng vào)
  // ============================================================================
  const source_ref = ref(source_schema, source_table);
}

-- ===========================================================================
-- LOGIC SQL (không cần đụng vào)
-- ===========================================================================

SELECT
    ${cols.join(",\n    ")}
FROM ${source_ref}