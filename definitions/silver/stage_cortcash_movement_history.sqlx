js {
    // 1. THÔNG TIN NGUỒN TỪ BRONZE
    const source_table = "CORTCASH_MOVEMENT_HISTORY";
    const source_partition_col = "ALLO_DATE";
    const unique_key_cols = ["ALLO_DATE", "REF_NO"];
    const dedupe_order_by = [
        { field: "UPD_DATE_TIME", sort: "DESC" }
    ];
    
    // 2. ĐẶT TÊN PARTITION CHO BẢNG NÀY (nhớ chỉnh ở block config):
        //snapshot_date cho mấy bảng dùng InsertDate
        //business_date cho mấy bảng chỉ có dữ liệu theo ngày làm việc
    const target_partition_col = "business_date"
    
    // 3. NHÓM TRƯỜNG DỮ LIỆU
    const date_cols = [
        "ALLO_DATE", "ENTRY_DATE", "SRC_DATE"
        ];
    const boolean_cols = [
        { source: "DEL_CD", field_name: "is_deleted", true_value: 9}
        ];
    const string_cols = [
        "CUST_NO", "SUB_ACCO_NO", "GROUP_CATEGORY", "TASK_CD", "SRC_TRANSACTION_CD", 
        "CURR_CD", "AMOUNT_TYPE", "UTIL_CD", "TRANSACTION_CD", "INTERNAL_BALANCE_CODE", 
        "DOC", "REMARKS", "MEMO", "APPROVED_USER_ID", "REG_USER_ID", "UPD_USER_ID"
        ];
    const integer_cols = [
        "REF_NO", "CUST_CD", "SUB_ACCO_CD", "APPROVEMENT_ID", "SRC_NO", 
        "TRADE_TYPE", "UTIL_CASH_ID", "STATUS"
        ];
    const numeric_cols = [
        "BEGIN_AMOUNT", "AMOUNT", "AFTER_AMOUNT"
        ];
    // Danh sách các trường không cần xử lý
    const cleaned_cols = [
        "APPROVED_DATE_TIME", "REG_DATE_TIME", "UPD_DATE_TIME"
        ];

    //-----------------------------------------
    // 4.XỬ LÝ BIẾN (không cần đụng vào)
    
    // Kiểm tra xem target_partition_col đã tồn tại trong date_cols chưa
    const has_partition_col = date_cols.some(
        col => col.toLowerCase() === target_partition_col.toLowerCase());

    // Danh sách tất cả các trường để select
    const output_cols = [
        "_hash_key",
        ...(has_partition_col ? [] : [target_partition_col]),
        ...date_cols,
        ...string_cols, 
        ...integer_cols, 
        ...numeric_cols, 
        ...cleaned_cols,
        ...boolean_cols.map(b => b.field_name)
    ].map(col => col.toLowerCase());
}

config {
    type: "incremental",
    schema: "silver",
    name: "stage_cortcash_movement_history",
    uniqueKey: ["_hash_key"],
    bigquery: {partitionBy: "business_date"},
    description: "Bảng Staging chuẩn hóa lịch sử giao dịch tiền của khách hàng từ hệ thống Core (CORTCASH_MOVEMENT_HISTORY). Thực hiện làm sạch dữ liệu chuỗi, xử lý ngày tháng và loại bỏ trùng lặp theo allo_date và ref_no.",
    tags: ["silver", "cash_movement", "daily"],
    columns: {
        _hash_key: "",
        _ingested_at: "",
        _updated_at: "",
        business_date: "Ngày partition dữ liệu, lấy từ allo_date",
        allo_date: "Kết hợp cùng ref_no để ra key",
        ref_no: "Kết hợp cùng allo_date để ra key",
        is_deleted: "Dữ liệu đã xóa hay chưa",
        cust_cd: "Mã định danh khách hàng",
        cust_no: "Số tài khoản khách hàng",
        sub_acco_cd: "Mã định danh tiểu khoản",
        sub_acco_no: "Số tiểu khoản",
        entry_date: "Ngày nhập liệu giao dịch",
        approvement_id: "ID phê duyệt giao dịch",
        group_category: "Phân loại nghiệp vụ",
        task_cd: "Mã tác vụ/giao dịch",
        src_date: "Ngày phát sinh nguồn",
        src_no: "Số tham chiếu nguồn",
        src_transaction_cd: "Đơn vị giao dịch khách hàng",
        curr_cd: "Mã loại tiền tệ",
        begin_amount: "Số dư đầu (Mục đích xử lý report, mặc định 0)",
        amount: "Số tiền giao dịch (Mặc định 0)",
        amount_type: "Loại số tiền (D: Debit, C: Credit)",
        trade_type: "Loại giao dịch (1: Debit, 2: Credit)",
        after_amount: "Số dư sau giao dịch (Mục đích xử lý report, mặc định 0)",
        util_cd: "Mã công cụ/tiện ích",
        util_cash_id: "ID tiền mặt tiện ích (Mặc định 0)",
        status: "Trạng thái giao dịch (Mặc định 0)",
        transaction_cd: "Đơn vị giao dịch nơi thực hiện",
        internal_balance_code: "Mã tài khoản nội bộ",
        doc: "Chứng từ liên quan",
        remarks: "Ghi chú giao dịch",
        memo: "Diễn giải chi tiết",
        approved_date_time: "Thời điểm phê duyệt",
        approved_user_id: "Người phê duyệt",
        reg_date_time: "Thời điểm đăng ký bản ghi",
        reg_user_id: "Người tạo bản ghi",
        upd_date_time: "Thời điểm cập nhật bản ghi",
        upd_user_id: "Người cập nhật bản ghi",
    }
}

pre_operations {
  -- 1. Xác định thời gian chạy
  DECLARE run_time TIMESTAMP DEFAULT CURRENT_TIMESTAMP();

  -- 2. Xác định target_date
  DECLARE target_date DATE;
  SET target_date = (
    SELECT 
      ${dataform.projectConfig.vars.target_date 
        ? `DATE('${dataform.projectConfig.vars.target_date}')` 
        : `MAX(${source_partition_col}) FROM ${ref("bronze", source_table)}`
      }
  );
}

WITH staging_data AS (
    SELECT
    ${[
        // Xác định key để join và partition field (nếu chưa có)
        `${func.generateHash(unique_key_cols.map(c => `CAST(${c} AS STRING)`))} AS _hash_key`,
        ...(has_partition_col ? [] : [`${func.cleanNullDate(source_partition_col)} AS ${target_partition_col.toLowerCase()}`]),

        // Clean dữ liệu
        ...date_cols.map(col => `${func.cleanNullDate(col)} AS ${col.toLowerCase()}`),
        ...string_cols.map(col => `${func.cleanNullString(col)} AS ${col.toLowerCase()}`),
        ...integer_cols.map(col => `CAST(${col} AS INT64) AS ${col.toLowerCase()}`),
        ...numeric_cols.map(col => `CAST(${col} AS NUMERIC) AS ${col.toLowerCase()}`),
        ...boolean_cols.map(b => `CAST(${b.source} AS INT64) = ${b.true_value} AS ${b.field_name}`),
        ...cleaned_cols.map(col => `${col} AS ${col.toLowerCase()}`)
    ].join(",\n        ")}

    FROM ${ref("bronze", source_table)}
    WHERE source_partition_col = target_date
    
    -- De-duplicate dữ liệu
    QUALIFY ROW_NUMBER() OVER (
        PARTITION BY ${unique_key_cols.join(", ")} 
        ORDER BY ${dedupe_order_by.map(o => `${o.field} ${o.sort}`).join(", ")}
    ) = 1
)

SELECT
    ${when(incremental(), `COALESCE(target._ingested_at, run_time)`, `run_time`)} AS _ingested_at,
    run_time AS _updated_at,
    ${output_cols.map(col => `stg.${col}`).join(",\n    ")}
FROM staging_data AS stg
${when(incremental(), 
  `LEFT JOIN ${self()} AS target ON stg._hash_key = target._hash_key`
)}