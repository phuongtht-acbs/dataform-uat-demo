js {
  // 1. Danh sách cột trong bảng
  const dim_cols = [
    "s.sub_acco_no", "s.sub_acco_cd", "s.is_deleted", "s.cust_cd", "s.acco_type", "s.algos_type",
    "s.type_flg", "s.curr_cd", "s.bank_cd", "s.bank_branch_cd", "s.bank_acco_number",
    "s.bank_acco_name", "s.bank_acco_id_no", "s.bank_flg", "s.not_update_by_cust",
    "s.contract_no", "s.source_channel", "s.broker_cd", "s.acco_sts", "s.acco_flg",
    "s.trade_acco_no", "s.status", "s.source_cd", "s.source_sname", "s.open_date",
    "s.close_date", "s.reopen_date", "s.remarks", "a.is_auto_advance", 
    "a.is_auto_mortgage", "a.retention_rate", "a.warning_rate", "a.tn_rate", 
    "a.call_rate", "a.withdraw_rate", "a.margin_limit_grp", "a.margin_limit"
  ];
  // 2. Danh sách cột để tạo CTE current_dim
  const cur_dim_cols = [
    { name: "sub_acco_no", type: "STRING" },
    { name: "record_hash", type: "BYTES" },
    { name: "dim_subaccount_key", type: "BYTES" },
    { name: "_ingested_at", type: "TIMESTAMP" }
  ];
}

config {
    type: "incremental",
    schema: "silver",
    name: "dim_subaccount",
    description: "Bảng Dimension SCD Type 2 cho tiểu khoản. valid_from/valid_to được xác định dựa trên ngày snapshot lớn nhất của dữ liệu nguồn.",
    tags: ["silver", "dimension", "daily", "subaccount"],
    uniqueKey: ["dim_subaccount_key"],
    bigquery: {
        partitionBy: "DATE(valid_from)",
        clusterBy: ['is_current']
    }
}

pre_operations {
  -- 1. Xác định thời gian chạy đồng nhất cho toàn bộ batch
  DECLARE run_time TIMESTAMP DEFAULT CURRENT_TIMESTAMP();
  -- 2. Xác định target_date: Ưu tiên biến vars, nếu không có sẽ lấy MAX từ 2 bảng staging
  DECLARE target_date DATE;
  SET target_date = (
    ${dataform.projectConfig.vars.target_date 
      ? `DATE('${dataform.projectConfig.vars.target_date}')` 
      : `(
          SELECT MAX(max_date) FROM (
            SELECT MAX(insert_date) AS max_date FROM ${ref("silver", "stage_cortsub_account")}
            UNION ALL
            SELECT MAX(insert_date) AS max_date FROM ${ref("silver", "stage_cortasset_ext")}
          )
        )`
    }
  );
}

-- 1. Lấy dữ liệu từ Staging của batch ngày target_date
WITH staging_data AS (
    SELECT
        ${func.generateHash(dim_cols)} AS record_hash,
        ${dim_cols.join(",\n        ")}
    FROM ${ref("silver", "stage_cortsub_account")} AS s
    LEFT JOIN ${ref("silver", "stage_cortasset_ext")} AS a 
        ON s.sub_acco_cd = a.sub_acco_cd AND a.insert_date = target_date
    WHERE s.insert_date = target_date
    -- Deduplicate logic
    QUALIFY ROW_NUMBER() OVER (PARTITION BY s.sub_acco_no ORDER BY s.sub_acco_cd DESC) = 1
),

-- 2. Xác định các bản ghi hiện tại trong Dimension
current_dim AS (
    ${func.getCurrentDim(incremental(), self(), cur_dim_cols)}
)

-- 3. Insert các record mới hoặc có thay đổi nội dung
SELECT
    ${when(incremental(), `COALESCE(cur._ingested_at, run_time)`, `run_time`)} AS _ingested_at,
    run_time AS _updated_at,
    ${func.generateHash(["stg.sub_acco_no", "CAST(target_date AS TIMESTAMP)"])} AS dim_subaccount_key,
    CAST(target_date AS TIMESTAMP) AS valid_from,
    CAST(NULL AS TIMESTAMP) AS valid_to,
    true AS is_current,
    stg.*
FROM staging_data AS stg
LEFT JOIN current_dim AS cur ON stg.sub_acco_no = cur.sub_acco_no
WHERE cur.sub_acco_no IS NULL OR stg.record_hash != cur.record_hash

post_operations {
-- 4. Đóng record cũ khi có phiên bản mới
  MERGE ${self()} AS t
  USING (
    SELECT
        s.sub_acco_no,
        ${func.generateHash([dim_cols])} AS record_hash,
    FROM ${ref("silver", "stage_cortsub_account")} AS s
    LEFT JOIN ${ref("silver", "stage_cortasset_ext")} AS a 
        ON s.sub_acco_cd = a.sub_acco_cd AND a.insert_date = target_date
    WHERE s.insert_date = target_date
    QUALIFY ROW_NUMBER() OVER (PARTITION BY s.sub_acco_no ORDER BY s.sub_acco_cd DESC) = 1
  ) AS src
  ON t.sub_acco_no = src.sub_acco_no
  AND t.is_current = true
  AND t.record_hash != src.record_hash
  WHEN MATCHED THEN 
    UPDATE SET
      t._updated_at = run_time,
      t.valid_to = CAST(target_date AS TIMESTAMP),
      t.is_current = false;
}