js {
  // 1. List of business columns now coming from the single stage_subaccount table
  const dim_cols = [
    "sub_acco_no", "sub_acco_cd", "is_deleted", "cust_cd", "acco_type", "algos_type",
    "type_flg", "curr_cd", "bank_cd", "bank_branch_cd", "bank_acco_number",
    "bank_acco_name", "bank_acco_id_no", "bank_flg", "not_update_by_cust",
    "contract_no", "source_channel", "broker_cd", "acco_sts", "acco_flg",
    "trade_acco_no", "status", "source_cd", "source_sname", "open_date",
    "close_date", "reopen_date", "remarks", "is_auto_advance", 
    "is_auto_mortgage", "retention_rate", "warning_rate", "tn_rate", 
    "call_rate", "withdraw_rate", "margin_limit_grp", "margin_limit"
  ];

  // 2. Metadata for creating the current_dim CTE
  const cur_dim_cols = [
    { name: "sub_acco_no", type: "STRING" },
    { name: "record_hash", type: "BYTES" },
    { name: "dim_subaccount_key", type: "BYTES" },
    { name: "_ingested_at", type: "TIMESTAMP" }
  ];

  // 3. Source partition field from stage_subaccount
  const source_partition_col = 'snapshot_date';
}

config {
    type: "incremental",
    schema: "silver",
    name: "dim_subaccount",
    description: "Bảng Dimension SCD Type 2 cho tiểu khoản. valid_from/valid_to được xác định dựa trên ngày snapshot lớn nhất của dữ liệu nguồn.",
    tags: ["silver", "dimension", "daily", "subaccount"],
    uniqueKey: ["dim_subaccount_key"],
    bigquery: {
        partitionBy: "DATE(valid_from)",
        clusterBy: ['is_current']
    }
}

pre_operations {
  -- 1. Unified run time
  DECLARE run_time TIMESTAMP DEFAULT CURRENT_TIMESTAMP();
  
  -- 2. Determine target_date: Derived directly from the consolidated staging table
  DECLARE target_date DATE;
  SET target_date = (
    ${dataform.projectConfig.vars.target_date 
      ? `DATE('${dataform.projectConfig.vars.target_date}')` 
      : `(SELECT MAX(${source_partition_col}) FROM ${ref("silver", "stage_subaccount")})`
    }
  );
}

-- 1. Fetch data from the consolidated Staging table
WITH staging_data AS (
    SELECT
        ${func.generateHash(dim_cols)} AS record_hash,
        ${dim_cols.join(",\n        ")}
    FROM ${ref("silver", "stage_subaccount")}
    WHERE ${source_partition_col} = target_date
    -- Deduplicate logic based on the core identifier
    QUALIFY ROW_NUMBER() OVER (PARTITION BY sub_acco_no ORDER BY sub_acco_cd DESC) = 1
),

-- 2. Identify currently active records in the Dimension
current_dim AS (
    ${func.getCurrentDim(incremental(), self(), cur_dim_cols)}
)

-- 3. Insert new or updated records (SCD Type 2 Logic)
SELECT
    ${when(incremental(), `COALESCE(cur._ingested_at, run_time)`, `run_time`)} AS _ingested_at,
    run_time AS _updated_at,
    ${func.generateHash(["stg.sub_acco_no", "CAST(target_date AS TIMESTAMP)"])} AS dim_subaccount_key,
    CAST(target_date AS TIMESTAMP) AS valid_from,
    CAST(NULL AS TIMESTAMP) AS valid_to,
    true AS is_current,
    stg.*
FROM staging_data AS stg
LEFT JOIN current_dim AS cur ON stg.sub_acco_no = cur.sub_acco_no
WHERE cur.sub_acco_no IS NULL OR stg.record_hash != cur.record_hash

post_operations {
-- 4. Close old records when a new version is created
  MERGE ${self()} AS t
  USING (
    SELECT
        sub_acco_no,
        ${func.generateHash(dim_cols)} AS record_hash
    FROM ${ref("silver", "stage_subaccount")}
    WHERE ${source_partition_col} = target_date
    QUALIFY ROW_NUMBER() OVER (PARTITION BY sub_acco_no ORDER BY sub_acco_cd DESC) = 1
  ) AS src
  ON t.sub_acco_no = src.sub_acco_no
  AND t.is_current = true
  AND t.record_hash != src.record_hash
  WHEN MATCHED THEN 
    UPDATE SET
      t._updated_at = run_time,
      t.valid_to = CAST(target_date AS TIMESTAMP),
      t.is_current = false;
}