js {
    // 1. THÔNG TIN NGUỒN TỪ BRONZE
    const source_table = "CORTCUSTOMER";
    const source_partition_col = "InsertDate";
    const unique_key_cols = ["CUST_CD"];
    const dedupe_order_by = [
        { field: "InsertTime", sort: "DESC" },
        { field: "UPD_DATE_TIME", sort: "DESC" }
    ];
    
    // 2. ĐẶT TÊN PARTITION CHO BẢNG NÀY
    const target_partition_col = "snapshot_date";
    
    // 3. NHÓM TRƯỜNG DỮ LIỆU
    const numeric_date_cols = [
        "BIRTHDAY", "ISSUE_DATE", "EXPIRE_DATE", "PRES_BIRTHDAY", 
        "PRES_ISSUE_DATE", "PRES_EXPIRE_DATE", "ACCO_ACT_DATE", 
        "ACCO_STS_DATE", "ACCO_STR_DATE", "CONTRACT_COMPLETE_DATE"
    ];
    
    const date_cols = [];
    
    const boolean_cols = [
        { source: "DEL_CD", field_name: "is_deleted", true_value: 9 }
    ];
    
    const string_cols = [
        "CUST_NO", "TRANSACTION_CD", "CUST_FAMILY_NAME", "CUST_GIVEN_NAME", 
        "TAX_CODE", "MOBILE_NO", "EMAIL_ADRS", "ID_NUMBER", "ISSUE_LOCATION", 
        "COUNTRY_CD", "BROKER_CD", "INTRODUCER_CD", "DEPARTMENT_CD", 
        "COM3_CUST_TYPE", "PRES_NAME", "PRES_POSITION", "PRES_COUNTRY_CD", 
        "PRES_ID_NUMBER", "PRES_ISSUE_LOCATION", "PRES_TEL_NO", "PRES_EMAIL_ADRS", 
        "CONTRACT_NO", "REASON_REJECT", "REMARKS", "SID", "PCOD", 
        "REG_USER_ID", "UPD_USER_ID"
    ];
    
    const integer_cols = [
        "CUST_CD", "CUST_TYPE", "FOREIGN_TYPE", "SEX", "EMAIL_FLG", 
        "APPROVAL_CD", "JOB", "CHANNEL_ID", "NUMBER_OF_SIG", "ACCO_DIVIDE", 
        "ACCO_STS", "ORDER_MONEY_CONF", "ORDER_STOCK_CONF", "NOT_COLLECT_TAX", 
        "CONTRACT_STATUS", "VSD_STATUS", "SRC_CHANNEL", "PRES_APPROVAL_CD"
    ];
    
    const numeric_cols = [];
    const float_cols = [];

    const cleaned_cols = [
        "REG_DATE_TIME", "UPD_DATE_TIME", "InsertTime", "InsertDate"
    ];

    //-----------------------------------------
    // 4. XỬ LÝ BIẾN
    
    const has_partition_col = date_cols.some(col => col.toLowerCase() === target_partition_col.toLowerCase());

    const output_cols = [
        "_hash_key",
        ...(has_partition_col ? [] : [target_partition_col]),
        ...date_cols,
        ...numeric_date_cols,
        ...string_cols, 
        ...integer_cols, 
        ...numeric_cols, 
        ...float_cols,
        ...cleaned_cols,
        ...boolean_cols.map(b => b.field_name)
    ].map(col => col.toLowerCase());
}

config {
    type: "incremental",
    schema: "silver",
    name: "stage_cortcustomer",
    uniqueKey: ["_hash_key"],
    bigquery: {
        partitionBy: "snapshot_date",
        updatePartitionFilter: "snapshot_date = target_date"
    },
    description: "Bảng Staging lưu trữ lịch sử snapshot thông tin khách hàng. Dữ liệu được chuẩn hóa và lưu trữ lịch sử theo từng ngày.",
    tags: ["silver", "stage", "customer", "daily"],
    columns: {
        // Audit & Keys
        _hash_key: "Khóa chính (Surrogate Key) sinh ra từ hash của CUST_CD",
        _ingested_at: "Thời điểm bản ghi lần đầu được đưa vào hệ thống",
        _updated_at: "Thời điểm bản ghi được cập nhật mới nhất trong Silver",
        snapshot_date: "Ngày snapshot dữ liệu (ánh xạ từ InsertDate)",

        cust_cd: "Một khách hàng cust_no có thể có nhiều cust_cd",
        is_deleted: "Dữ liệu đã xóa hay chưa",
        cust_no: "Số tài khoản lưu ký, giao dịch",
        transaction_cd: "Đơn vị giao dịch",
        cust_family_name: "Họ khách hàng",
        cust_given_name: "Tên khách hàng",
        tax_code: "Mã số Thuế TNCN",
        cust_type: "1: Cá nhân; 2: Tổ chức",
        foreign_type: "1: Trong nước; 2: Nước ngoài",
        birthday: "Ngày sinh",
        sex: "1: Nam; 2: Nữ",
        mobile_no: "Số điện thoại di động",
        email_adrs: "Địa chỉ Email",
        email_flg: "0:NO; 1:YES",
        approval_cd: "Loại giấy tờ định danh (1-CMND, 2-Passport, 8-CCCD, ...)",
        id_number: "Số ĐKSH (Số CMND/CCCD/Passport)",
        issue_location: "Nơi cấp giấy tờ",
        issue_date: "Ngày cấp (YYYYMMDD)",
        expire_date: "Ngày hết hạn (YYYYMMDD)",
        country_cd: "Mã quốc gia",
        job: "Mã nghề nghiệp",
        broker_cd: "Nhân viên chăm sóc",
        introducer_cd: "Nhân viên giới thiệu",
        department_cd: "Mã phòng kinh doanh",
        com3_cust_type: "Nhóm hoa hồng",
        pres_name: "Họ và tên người đại diện",
        pres_birthday: "Ngày sinh của người đại diện",
        pres_position: "Chức vụ người đại diện",
        pres_country_cd: "Quốc tịch người đại diện",
        pres_approval_cd: "Loại chứng thư người đại diện",
        pres_id_number: "Số CMND người đại diện",
        pres_issue_location: "Nơi cấp (Người đại diện)",
        pres_issue_date: "Ngày cấp người đại diện (YYYYMMDD)",
        pres_expire_date: "Ngày hết hạn người đại diện (YYYYMMDD)",
        pres_tel_no: "Số điện thoại người đại diện",
        pres_email_adrs: "Email người đại diện",
        channel_id: "Kênh tiếp cận",
        number_of_sig: "Số lượng chữ ký",
        acco_divide: "Phân loại tài khoản (1: Thông thường, 2: Tự doanh, 3: Không lưu ký)",
        acco_sts: "Trạng thái tài khoản (1: New, 2: Sleeping, 3: Active, 4: Closed)",
        acco_act_date: "Ngày kích hoạt lại",
        acco_sts_date: "Ngày chuyển trạng thái",
        acco_str_date: "Ngày mở tài khoản",
        contract_complete_date: "Ngày hoàn thiện hồ sơ",
        contract_no: "Số hợp đồng",
        order_money_conf: "Có kiểm tra tiền không (0:NO, 1:YES)",
        order_stock_conf: "Có kiểm tra chứng khoán không (0:NO, 1:YES)",
        not_collect_tax: "Có thu thuế (0: Có thu, 1: Không thu)",
        contract_status: "Trạng thái hoàn thiện hồ sơ",
        vsd_status: "Trạng thái gửi lên VSD",
        reason_reject: "Lý do từ chối",
        src_channel: "Kênh mở tài khoản",
        remarks: "Ghi chú đặc điểm của khách hàng",
        reg_date_time: "Thời gian đăng ký",
        reg_user_id: "Người đăng ký",
        upd_date_time: "Thời gian cập nhật",
        upd_user_id: "Người cập nhật",
        insertdate: "Ngày snapshot dữ liệu",
        inserttime: "Thời điểm snapshot dữ liệu",
        sid: "Mã SID định danh VSD",
        pcod: "Mã NĐT VSD"
    }
}

pre_operations {
  -- 1. Khai báo biến
  DECLARE run_time TIMESTAMP DEFAULT CURRENT_TIMESTAMP();
  DECLARE target_date DATE;
  DECLARE start_date DATE;
  DECLARE end_date DATE;

  -- 2. Logic xác định thời gian dựa trên loại hình chạy
  ${incremental() 
    ? `SET target_date = ${dataform.projectConfig.vars.target_date 
        ? `DATE('${dataform.projectConfig.vars.target_date}')` 
        : `(SELECT MAX(${source_partition_col}) FROM ${ref("bronze", source_table)})`
      };`
    : `SET start_date = ${dataform.projectConfig.vars.start_date 
        ? `DATE('${dataform.projectConfig.vars.start_date}')` 
        : `(SELECT MIN(${source_partition_col}) FROM ${ref("bronze", source_table)})`
      };
      SET end_date = ${dataform.projectConfig.vars.end_date 
        ? `DATE('${dataform.projectConfig.vars.end_date}')` 
        : `(SELECT MAX(${source_partition_col}) FROM ${ref("bronze", source_table)})`
      };
      SET target_date = NULL; -- Đảm bảo updatePartitionFilter không bị lỗi khi biên dịch`
  }

  -- 3. Drop table khi Full Refresh
  ${when(!incremental(), `DROP TABLE IF EXISTS ${self()};`)}
}

WITH staging_data AS (
    SELECT
    ${[
        // Xác định key để join và partition field (nếu chưa có)
        `${func.generateHash(unique_key_cols.map(c => `CAST(${c} AS STRING)`))} AS _hash_key`,
        ...(has_partition_col ? [] : [`${func.cleanNullDate(source_partition_col)} AS ${target_partition_col.toLowerCase()}`]),

        // Clean dữ liệu
        ...date_cols.map(col => `${func.cleanNullDate(col)} AS ${col.toLowerCase()}`),
        ...numeric_date_cols.map(col => `${func.parseNumericDate(col)} AS ${col.toLowerCase()}`),
        ...string_cols.map(col => `${func.cleanNullString(col)} AS ${col.toLowerCase()}`),
        ...integer_cols.map(col => `CAST(${col} AS INT64) AS ${col.toLowerCase()}`),
        ...numeric_cols.map(col => `CAST(${col} AS NUMERIC) AS ${col.toLowerCase()}`),
        ...float_cols.map(col => `CAST(${col} AS FLOAT64) AS ${col.toLowerCase()}`),
        ...boolean_cols.map(b => `CAST(${b.source} AS INT64) = ${b.true_value} AS ${b.field_name}`),
        ...cleaned_cols.map(col => `${col} AS ${col.toLowerCase()}`)
    ].join(",\n        ")}

    FROM ${ref("bronze", source_table)}
    WHERE
        ${incremental() 
          ? `${source_partition_col} = target_date` 
          : `${source_partition_col} BETWEEN start_date AND end_date`
        }
    -- Deduplicate dựa trên key duy nhất
    QUALIFY ROW_NUMBER() OVER (
        PARTITION BY ${unique_key_cols.join(", ")} 
        ORDER BY ${dedupe_order_by.map(o => `${o.field} ${o.sort}`).join(", ")}
    ) = 1
)

SELECT
    ${when(incremental(), `COALESCE(target._ingested_at, run_time)`, `run_time`)} AS _ingested_at,
    run_time AS _updated_at,
    ${output_cols.map(col => `stg.${col}`).join(",\n    ")}
FROM staging_data AS stg
${when(incremental(), 
  `LEFT JOIN ${self()} AS target ON stg._hash_key = target._hash_key AND target.${target_partition_col} = target_date`
)}