config {
  type: "incremental",
  schema: "gold",
  name: "order",
  description: "Thông tin lệnh gốc và lệnh đẩy vào sàn",
  uniqueKey: ["order_key"],
  tags: ["gold", "fact", "order", "daily"],
  bigquery: {
      partitionBy: "trade_date",
      clusterBy: ["org_order_no"],
      updatePartitionFilter: "trade_date = target_date"
  },
  dependOnDependencyAssertions: true
}

js {
  // ============================================================================
  // BƯỚC 2: Cấu hình thông tin bảng fact nguồn từ lớp Silver
  // ============================================================================
  const baseTable = {
    bronzeSourceName: "ORDTORDER_HIST",
    ref: ref("silver", "fact_order"),
    partitionCol: "trade_date",
    alias: "t",
    columns: [
      "org_order_no", "is_deleted", "req_no", "req_type", "req_time", 
      "order_no", "confirm_no", "confirm_time", "market_cd", "session_cd", 
      "org_ord_type", "ord_type", "ord_chanel", "sec_cd", "sec_type", "trade_type", 
      "side_type", "ord_qty", "ord_price", "ord_amt", "stop_price", "ord_qty2", 
      "cash_qty", "sub_acco_cd", "sub_acco_no", "cust_cd", "cust_no", "cust_flag", 
      "cust_family_name", "cust_given_name", "cust_transaction_cd", "firm_no", 
      "trader_id", "bank_branch_cd", "fee_rate", "fee_amt", "commi_rate", "commi_amt", 
      "tax_rate", "tax_amt", "trans_rate", "trans_amt", "right_tax_rate", "right_tax_qty", 
      "right_tax_amt", "margin_rate", "margin_amt", "pub_qty", "pub_price", "can_qty", 
      "mat_qty", "mat_amt", "tag", "notes", "remarks", "transaction_cd", "broker_cd", 
      "intro_cd", "service_type", "settle_unit", "payment_date", "is_resolved", 
      "leader_flag", "is_over_limited", "is_online", "active_stop", "group_cd", 
      "mort_contr_no", "avail_after", "avail_before", "current_rate_before", 
      "current_rate_after", "client_info", "confirm_client_info", "ord_src_type", 
      "ord_src_no", "cl_ord_id", "odd_flag", "priority", "status", "apr_date_time", 
      "apr_user_id", "confirm_status", "confirm_date_time"
    ]
  };
  // ============================================================================
  // BƯỚC 3: Cấu hình Surrogate Key cho bảng Fact Gold hiện tại
  // ============================================================================
  const surrogateKey = {
    name: "order_key",
    elements: ["trade_date", "org_order_no"]
  };
  // ============================================================================
  // BƯỚC 4: Cấu hình các bảng dim cần join để lấy history key và các trường liên quan
  // ============================================================================
  const historyDimensions = [
    { ref: ref("silver", "dim_customer"), alias: "c", leftKey: "t.cust_no", rightKey: "cust_no", columns: ["customer_history_key"] },
    { ref: ref("silver", "dim_broker"), alias: "br", leftKey: "t.broker_cd", rightKey: "broker_cd", columns: ["broker_history_key"] },
    { ref: ref("silver", "dim_security"), alias: "sec", leftKey: "t.sec_cd", rightKey: "sec_cd", columns: ["security_history_key"] },
    { ref: ref("silver", "dim_transaction"), alias: "c_tr", leftKey: "t.cust_transaction_cd", rightKey: "transaction_cd", columns: ["transaction_history_key as cust_transaction_history_key"] },
    { ref: ref("silver", "dim_transaction"), alias: "tr", leftKey: "t.transaction_cd", rightKey: "transaction_cd", columns: ["transaction_history_key"] },
    { ref: ref("silver", "dim_subaccount"), alias: "sa", leftKey: "t.sub_acco_no", rightKey: "sub_acco_no", columns: ["subaccount_history_key"] },
    { ref: ref("silver", "dim_market"), alias: "m", leftKey: "t.market_cd", rightKey: "market_cd", columns: ["market_history_key"] }
  ];
  // ============================================================================
  // BƯỚC 5: Cấu hình các thuộc tính cần tra cứu giá trị chữ từ dim_attribute_lookup
  // ============================================================================
  const lookupAttributes = {
    ord_src_type: "ORDTORDER__ORD_SRC_TYPE",
    status: "ORDTORDER__STATUS",
    ord_chanel: "ORDTORDER__ORD_CHANEL",
    trade_type: "ORDTORDER__TRADE_TYPE",
    service_type: "ORDTORDER__SERVICE_TYPE"
  };
  // ============================================================================
  // BƯỚC 6: Biến hỗ trợ hệ thống (Không cần sửa đổi)
  // ============================================================================
  const checkpoint_ref = ref("silver", "bronze_checkpoint");
  const lookup_ref = ref("silver", "dim_attribute_lookup")
}

-- ===========================================================================
-- LOGIC SQL (KHÔNG CẦN ĐỤNG VÀO)
-- ===========================================================================

pre_operations {
  DECLARE run_time TIMESTAMP DEFAULT CURRENT_TIMESTAMP();
  DECLARE target_date DATE;

  ${incremental() 
    ? `SET target_date = ${dataform.projectConfig.vars.target_date 
        ? `DATE('${dataform.projectConfig.vars.target_date}')` 
        : `(SELECT latest_date FROM ${checkpoint_ref} WHERE table_name = '${baseTable.bronzeSourceName}')`
      };`
    : `SET target_date = NULL;`
  }

  ${when(!incremental(), `DROP TABLE IF EXISTS ${self()};`)}
}

WITH staging_data AS (
    SELECT
        -- Tạo surrogate key và select trường để partition
        ${func.generateHash(surrogateKey.elements.map(el => 
            el.includes("'") ? el : `CAST(${baseTable.alias}.${el} AS STRING)`
        ))} AS ${surrogateKey.name},
        ${baseTable.alias}.${baseTable.partitionCol},
       
        -- Các history key và natural key từ các đối tượng khác
        ${func.renderHistoryColumns(historyDimensions)}

        -- Tự động render các cột tên từ bảng tra cứu thuộc tính
        ${func.renderLookupColumns(lookupAttributes)}

        -- Giá trị tên thuộc tính sau khi lookup bảng dim_attribute_lookup
        ${baseTable.columns.map(col => `${baseTable.alias}.${col}`).join(",\n            ")},

    FROM ${baseTable.ref} AS ${baseTable.alias}
    
    -- Join để lấy history key
    ${historyDimensions.map(
        j => func.joinHistory(j.ref, j.alias, j.leftKey, j.rightKey, `DATE(${baseTable.alias}.${baseTable.partitionCol})`)
    ).join("\n    ")}

    -- Join để lookup giá trị tên thuộc tính
    ${Object.entries(lookupAttributes).map(([col, category]) => `LEFT JOIN ${lookup_ref} AS lkp_${col}
        ON lkp_${col}.category = '${category}'
        AND cast(${baseTable.alias}.${col} as STRING) = cast(lkp_${col}.attribute_code as STRING)`).join("\n\n")}

    -- Filter ngày cần xử lý
    ${when(incremental(), `WHERE ${baseTable.alias}.${baseTable.partitionCol} = target_date`)}
)

-- Logic xử lý incremental
SELECT
    ${when(incremental(), `COALESCE(target._ingested_at, run_time)`, `run_time`)} AS _ingested_at,
    run_time AS _updated_at,
    stg.*
FROM staging_data AS stg
${when(incremental(), 
  `LEFT JOIN ${self()} AS target ON stg.${surrogateKey.name} = target.${surrogateKey.name} AND target.${baseTable.partitionCol} = target_date`
)}