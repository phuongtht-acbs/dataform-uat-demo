config {
    type: "incremental",
    schema: "gold",
    name: "subaccount_history",
    description: "Full denormalized SCD Type 2 Subaccount history.",
    tags: ["gold", "subaccount", "history"],
    uniqueKey: ["subaccount_history_key"],
    bigquery: {
        partitionBy: "DATE(valid_from)",
        clusterBy: ['is_current']
    }
}

js {
  // 1. SQL-specific configuration
  const natural_key = "sub_acco_no";
  const history_key = "subaccount_history_key";

  // Configuration for deriving the target_date
  const target_date_col = "snapshot_date";
  const target_date_source = ref("silver", "stage_cortsub_account");

  // 2. Explicitly list the fields we want to keep from the silver dimension
  const source_table = ref("silver", "dim_subaccount");
  const source_cols = [
    "sub_acco_cd", "sub_acco_no", "cust_cd", "cust_group_id",
    "is_deleted", "acco_type", "algos_type", "type_flg", "curr_cd",
    "bank_cd", "bank_branch_cd", "bank_acco_number", "bank_acco_name", "bank_acco_id_no", "bank_flg",
    "not_update_by_cust", "contract_no", "source_channel", "broker_cd",
    "acco_sts", "acco_flg", "trade_acco_no", "status",
    "source_cd", "source_sname", "remarks", "open_date", "close_date", "reopen_date",
    "is_auto_advance", "is_auto_mortgage", "retention_rate",
    "warning_rate", "tn_rate", "call_rate", "withdraw_rate",
    "margin_limit_grp", "margin_limit"
  ];

  // 3. Explicitly list the enriched fields added via JOINS
  const enriched_cols = [
    "acco_type_name", "acco_sts_name", "status_name", "source_channel_name", "bank_flg_name",
    "customer_history_key", "broker_history_key"
  ];

  // Combine both arrays for the comprehensive SCD2 record hash
  const gold_cols = [...source_cols, ...enriched_cols];

  // 4. Centralized Denormalization Logic
  const denorm_query = `
    SELECT
        ${func.generateHash(gold_cols)} AS record_hash,
        *
    FROM (
        SELECT
            ${source_cols.map(col => `s.${col}`).join(",\n            ")},
            
            lkp_alg.attribute_name as algos_type_name,
            lkp_type.attribute_name AS acco_type_name,
            lkp_ast.attribute_name AS acco_sts_name,
            lkp_sts.attribute_name AS status_name,
            lkp_src.attribute_name AS source_channel_name,
            lkp_bnk.attribute_name AS bank_flg_name,
            
            c.customer_history_key,
            b.broker_history_key
            
        FROM ${source_table} AS s
        
        LEFT JOIN ${ref("silver", "dim_attribute_lookup")} AS lkp_type 
          ON lkp_type.category = 'CORTSUB_ACCOUNT__ACCO_TYPE'
          AND s.acco_type = lkp_type.attribute_code
        LEFT JOIN ${ref("silver", "dim_attribute_lookup")} AS lkp_sts
          ON lkp_sts.category = 'CORTSUB_ACCOUNT__STATUS'
          AND s.status = lkp_sts.attribute_code
        LEFT JOIN ${ref("silver", "dim_attribute_lookup")} AS lkp_src
          ON lkp_src.category = 'CORTSUB_ACCOUNT__SOURCE_CHANNEL'
          AND s.source_channel = lkp_src.attribute_code
        LEFT JOIN ${ref("silver", "dim_attribute_lookup")} AS lkp_bnk
          ON lkp_bnk.category = 'CORTSUB_ACCOUNT__BANK_FLG'
          AND s.bank_flg = lkp_bnk.attribute_code
        LEFT JOIN ${ref("silver", "dim_attribute_lookup")} AS lkp_ast
          ON lkp_ast.category = 'CORTSUB_ACCOUNT__ACCO_STS'
          AND s.acco_sts = lkp_ast.attribute_code
        LEFT JOIN ${ref("silver", "dim_attribute_lookup")} AS lkp_alg
          ON lkp_alg.category = 'CORTSUB_ACCOUNT__ALGOS_TYPE'
          AND s.algos_type = lkp_alg.attribute_code
        
        ${func.joinHistory(ref("gold", "customer_history"), "c", "s.cust_cd", "cust_cd", "target_date")}
        ${func.joinHistory(ref("gold", "broker_history"), "b", "s.broker_cd", "broker_cd", "target_date")}
        WHERE target_date >= DATE(s.valid_from) AND (s.valid_to IS NULL OR target_date < DATE(s.valid_to))
    )
  `;

  // Helper for getCurrentDim metadata
  const cur_dim_cols = [
    { name: natural_key, type: "STRING" },
    { name: "record_hash", type: "BYTES" },
    { name: "_ingested_at", type: "TIMESTAMP" }
  ];
}

pre_operations {
  DECLARE run_time TIMESTAMP DEFAULT CURRENT_TIMESTAMP();
  DECLARE target_date DATE;
  SET target_date = (
    ${dataform.projectConfig.vars.target_date 
      ? `DATE('${dataform.projectConfig.vars.target_date}')` 
      : `(SELECT MAX(${target_date_col}) FROM ${target_date_source})`
    }
  );
  ${when(!incremental(), `DROP TABLE IF EXISTS ${self()};`)}
}

WITH
  staging_hashed AS (${denorm_query}),
  current_gold AS (${func.getCurrentDim(incremental(), self(), cur_dim_cols)})

SELECT
    ${when(incremental(), `COALESCE(cur._ingested_at, run_time)`, `run_time`)} AS _ingested_at,
    run_time AS _updated_at,
    ${func.generateHash(["stg." + natural_key, "CAST(target_date AS STRING)"])} AS ${history_key},
    CAST(target_date AS TIMESTAMP) AS valid_from,
    CAST(NULL AS TIMESTAMP) AS valid_to,
    true AS is_current,
    stg.*
FROM staging_hashed AS stg
LEFT JOIN current_gold AS cur ON stg.${natural_key} = cur.${natural_key}
WHERE cur.${natural_key} IS NULL OR stg.record_hash != cur.record_hash

post_operations {
  ${func.expireHistory(self(), natural_key, denorm_query)}
}