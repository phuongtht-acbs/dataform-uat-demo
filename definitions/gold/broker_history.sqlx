config {
    type: "table", // Changed from "incremental" to "view" (or "table" if dashboard performance requires it)
    schema: "gold",
    name: "broker_history",
    description: "Lịch sử thông tin của môi giới. Lưu ý: thông tin tại thời điểm valid_from, bất kì thay đổi nào ở các đối tượng bên ngoài sau valid_from sẽ không được phản ánh vào đây",
    tags: ["gold", "broker", "history"],
    bigquery: {
        partitionBy: 'DATE(valid_from)',
        clusterBy: ['is_current']
    }
}

SELECT
    -- 0. Surrogate Key Mapping
    -- We alias the key created in Silver to represent the Gold history key
    b.dim_broker_key AS broker_history_key,

    -- 1. Core Broker Attributes (From Silver)
    b.broker_cd,
    b.parent_broker_cd,
    b.family_name,
    b.given_name,
    b.mobile_no,
    b.email_adrs,
    b.adrs_1,
    b.adrs_2,
    b.id_number,
    b.issue_location,
    b.issue_date,
    b.expire_date,
    b.user_id,
    b.transaction_cd,
    b.acco_begin_date,
    b.acco_end_date,
    b.ctv_corp_id,
    b.exc_begin_date,
    b.cert_begin_date,
    b.business_type,
    b.broker_type_id,
    b.depend_number,
    b.insurance_salary,
    b.basic_salary,
    b.end_basic_salary_month,
    b.remarks,

    -- 2. Enriched Lookups (Translating codes to readable names)
    lkp_emp.attribute_name AS employee_type_name,
    lkp_sts.attribute_name AS acco_sts_name,
    lkp_app.attribute_name AS approval_type_name,

    -- 3. Keys dắt tới thông tin chi nhánh (sẽ bổ sung)

    -- 4. Thông tin kĩ thuật
    b.valid_from,
    b.valid_to,
    b.is_current,
    b._ingested_at,
    b._updated_at

FROM ${ref("silver", "dim_broker")} AS b

-- ==========================================
-- LOOKUP JOINS
-- ==========================================
LEFT JOIN ${ref("silver", "dim_attribute_lookup")} AS lkp_emp 
    ON lkp_emp.category = 'BRKTBROKER__EMPLOYEE_TYPE'
    AND b.employee_type = lkp_emp.attribute_code

LEFT JOIN ${ref("silver", "dim_attribute_lookup")} AS lkp_sts 
    ON lkp_sts.category = 'BRKTBROKER__ACCO_STS'
    AND b.acco_sts = lkp_sts.attribute_code

LEFT JOIN ${ref("silver", "dim_attribute_lookup")} AS lkp_app 
    ON lkp_app.category = 'BRKTBROKER__APPROVAL_CD'
    AND b.approval_cd = lkp_app.attribute_code