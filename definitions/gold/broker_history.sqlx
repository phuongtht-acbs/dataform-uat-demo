js {
  // 1. Comprehensive list of business fields for the Gold layer (excluding technical metadata)
  const gold_cols = [
    "broker_cd", "parent_broker_cd", "family_name", "given_name",
    "mobile_no", "email_adrs", "adrs_1", "adrs_2", "id_number", "issue_location",
    "issue_date", "expire_date", "user_id", "transaction_cd", "acco_begin_date",
    "acco_end_date", "ctv_corp_id", "exc_begin_date", "cert_begin_date",
    "business_type", "broker_type_id", "depend_number", "insurance_salary",
    "basic_salary", "end_basic_salary_month", "remarks",
    "employee_type_name", "acco_sts_name", "approval_type_name"
  ];

  // 2. Metadata for identifying currently active records in Gold for comparison
  const cur_dim_cols = [
    { name: "broker_cd", type: "STRING" },
    { name: "record_hash", type: "BYTES" },
    { name: "_ingested_at", type: "TIMESTAMP" }
  ];
}

config {
    type: "incremental",
    schema: "gold",
    name: "broker_history",
    description: "Full denormalized SCD Type 2 Broker history. valid_from/to reflect target_date.",
    tags: ["gold", "broker", "history"],
    uniqueKey: ["broker_history_key"],
    bigquery: {
        partitionBy: "DATE(valid_from)",
        clusterBy: ['is_current']
    }
}

pre_operations {
  DECLARE run_time TIMESTAMP DEFAULT CURRENT_TIMESTAMP();
  DECLARE target_date DATE;
  -- target_date is derived from the latest snapshot date in staging
  SET target_date = (
    ${dataform.projectConfig.vars.target_date 
      ? `DATE('${dataform.projectConfig.vars.target_date}')` 
      : `(SELECT MAX(insert_date) FROM ${ref("silver", "stage_brktbroker")})`
    }
  );
}

-- 1. Combined logic: Subquery for denormalization, outer query for content hashing
WITH staging_hashed AS (
    SELECT
        ${func.generateHash(gold_cols)} AS record_hash,
        *
    FROM (
        SELECT
            b.broker_cd, b.parent_broker_cd, b.family_name, b.given_name,
            b.mobile_no, b.email_adrs, b.adrs_1, b.adrs_2, b.id_number, b.issue_location,
            b.issue_date, b.expire_date, b.user_id, b.transaction_cd, b.acco_begin_date,
            b.acco_end_date, b.ctv_corp_id, b.exc_begin_date, b.cert_begin_date,
            b.business_type, b.broker_type_id, b.depend_number, b.insurance_salary,
            b.basic_salary, b.end_basic_salary_month, b.remarks,
            -- Lookups for readable attribute names
            lkp_emp.attribute_name AS employee_type_name,
            lkp_sts.attribute_name AS acco_sts_name,
            lkp_app.attribute_name AS approval_type_name
        FROM ${ref("silver", "dim_broker")} AS b
        LEFT JOIN ${ref("silver", "dim_attribute_lookup")} AS lkp_emp 
            ON lkp_emp.category = 'BRKTBROKER__EMPLOYEE_TYPE' AND b.employee_type = lkp_emp.attribute_code
        LEFT JOIN ${ref("silver", "dim_attribute_lookup")} AS lkp_sts 
            ON lkp_sts.category = 'BRKTBROKER__ACCO_STS' AND b.acco_sts = lkp_sts.attribute_code
        LEFT JOIN ${ref("silver", "dim_attribute_lookup")} AS lkp_app 
            ON lkp_app.category = 'BRKTBROKER__APPROVAL_CD' AND b.approval_cd = lkp_app.attribute_code
        WHERE b.is_current = true
    )
),

-- 2. Identify currently active records in Gold
current_gold AS (
    ${func.getCurrentDim(incremental(), self(), cur_dim_cols)}
)

-- 3. Insert new or changed versions based on the target_date
SELECT
    ${when(incremental(), `COALESCE(cur._ingested_at, run_time)`, `run_time`)} AS _ingested_at,
    run_time AS _updated_at,
    ${func.generateHash(["stg.broker_cd", "CAST(target_date AS STRING)"])} AS broker_history_key,
    CAST(target_date AS TIMESTAMP) AS valid_from,
    CAST(NULL AS TIMESTAMP) AS valid_to,
    true AS is_current,
    stg.*
FROM staging_hashed AS stg
LEFT JOIN current_gold AS cur ON stg.broker_cd = cur.broker_cd
-- Insert only if broker is new or content (record_hash) has changed
WHERE cur.broker_cd IS NULL OR stg.record_hash != cur.record_hash

post_operations {
  -- 4. Expire old records in Gold using identical subquery logic
  MERGE ${self()} AS t
  USING (
    SELECT
        ${func.generateHash(gold_cols)} AS record_hash,
        broker_cd
    FROM (
        SELECT
            b.broker_cd, b.parent_broker_cd, b.family_name, b.given_name,
            b.mobile_no, b.email_adrs, b.adrs_1, b.adrs_2, b.id_number, b.issue_location,
            b.issue_date, b.expire_date, b.user_id, b.transaction_cd, b.acco_begin_date,
            b.acco_end_date, b.ctv_corp_id, b.exc_begin_date, b.cert_begin_date,
            b.business_type, b.broker_type_id, b.depend_number, b.insurance_salary,
            b.basic_salary, b.end_basic_salary_month, b.remarks,
            lkp_emp.attribute_name AS employee_type_name,
            lkp_sts.attribute_name AS acco_sts_name,
            lkp_app.attribute_name AS approval_type_name
        FROM ${ref("silver", "dim_broker")} AS b
        LEFT JOIN ${ref("silver", "dim_attribute_lookup")} AS lkp_emp ON lkp_emp.category = 'BRKTBROKER__EMPLOYEE_TYPE' AND b.employee_type = lkp_emp.attribute_code
        LEFT JOIN ${ref("silver", "dim_attribute_lookup")} AS lkp_sts ON lkp_sts.category = 'BRKTBROKER__ACCO_STS' AND b.acco_sts = lkp_sts.attribute_code
        LEFT JOIN ${ref("silver", "dim_attribute_lookup")} AS lkp_app ON lkp_app.category = 'BRKTBROKER__APPROVAL_CD' AND b.approval_cd = lkp_app.attribute_code
        WHERE b.is_current = true
    )
  ) AS s
  ON t.broker_cd = s.broker_cd 
  AND t.is_current = true 
  AND t.record_hash != s.record_hash
  WHEN MATCHED THEN
    UPDATE SET
      t._updated_at = run_time,
      t.valid_to = CAST(target_date AS TIMESTAMP),
      t.is_current = false;
}