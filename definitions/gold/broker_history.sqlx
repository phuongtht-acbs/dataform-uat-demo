js {
  // 1. Clean list of Gold layer column names (no table aliases)
  const gold_cols = [
    "broker_cd", "parent_broker_cd", "family_name", "given_name",
    "mobile_no", "email_adrs", "id_number", "user_id", "transaction_cd",
    "employee_type_name", "acco_sts_name", "approval_type_name",
    "basic_salary", "remarks"
  ];

  // 2. Metadata for identifying currently active records in Gold
  const cur_dim_cols = [
    { name: "broker_cd", type: "STRING" },
    { name: "record_hash", type: "BYTES" },
    { name: "_ingested_at", type: "TIMESTAMP" }
  ];
}

config {
    type: "incremental",
    schema: "gold",
    name: "broker_history",
    description: "Denormalized SCD Type 2 for Broker history. valid_from/to use target_date for daily tracking.",
    tags: ["gold", "broker", "history"],
    uniqueKey: ["broker_history_key"],
    bigquery: {
        partitionBy: "DATE(valid_from)"
    }
}

pre_operations {
  DECLARE run_time TIMESTAMP DEFAULT CURRENT_TIMESTAMP();
  DECLARE target_date DATE;
  -- target_date is derived from the staging table to reflect the latest snapshot date
  SET target_date = (
    ${dataform.projectConfig.vars.target_date 
      ? `DATE('${dataform.projectConfig.vars.target_date}')` 
      : `(SELECT MAX(insert_date) FROM ${ref("silver", "stage_brktbroker")})`
    }
  );
}

-- 1. Combined staging logic using a subquery to isolate joins from hashing
WITH staging_hashed AS (
    SELECT
        ${func.generateHash(gold_cols)} AS record_hash,
        *
    FROM (
        SELECT
            b.broker_cd, b.parent_broker_cd, b.family_name, b.given_name,
            b.mobile_no, b.email_adrs, b.id_number, b.user_id, b.transaction_cd,
            lkp_emp.attribute_name AS employee_type_name,
            lkp_sts.attribute_name AS acco_sts_name,
            lkp_app.attribute_name AS approval_type_name,
            b.basic_salary, b.remarks
        FROM ${ref("silver", "dim_broker")} AS b
        LEFT JOIN ${ref("silver", "dim_attribute_lookup")} AS lkp_emp 
            ON lkp_emp.category = 'BRKTBROKER__EMPLOYEE_TYPE' AND b.employee_type = lkp_emp.attribute_code
        LEFT JOIN ${ref("silver", "dim_attribute_lookup")} AS lkp_sts 
            ON lkp_sts.category = 'BRKTBROKER__ACCO_STS' AND b.acco_sts = lkp_sts.attribute_code
        LEFT JOIN ${ref("silver", "dim_attribute_lookup")} AS lkp_app 
            ON lkp_app.category = 'BRKTBROKER__APPROVAL_CD' AND b.approval_cd = lkp_app.attribute_code
        WHERE b.is_current = true
    )
),

-- 2. Identify currently active records in Gold for comparison
current_gold AS (
    ${func.getCurrentDim(incremental(), self(), cur_dim_cols)}
)

-- 3. Insert new versions for the target_date batch
SELECT
    ${when(incremental(), `COALESCE(cur._ingested_at, run_time)`, `run_time`)} AS _ingested_at,
    run_time AS _updated_at,
    ${func.generateHash(["stg.broker_cd", "CAST(target_date AS STRING)"])} AS broker_history_key,
    CAST(target_date AS TIMESTAMP) AS valid_from,
    CAST(NULL AS TIMESTAMP) AS valid_to,
    true AS is_current,
    stg.*
FROM staging_hashed AS stg
LEFT JOIN current_gold AS cur ON stg.broker_cd = cur.broker_cd
-- Only update if the broker is new to Gold or a change is detected in the hashed payload
WHERE cur.broker_cd IS NULL OR stg.record_hash != cur.record_hash

post_operations {
  -- 4. Expire old records using the same subquery logic in the MERGE
  MERGE ${self()} AS t
  USING (
    SELECT
        ${func.generateHash(gold_cols)} AS record_hash,
        broker_cd
    FROM (
        SELECT
            b.broker_cd, b.parent_broker_cd, b.family_name, b.given_name,
            b.mobile_no, b.email_adrs, b.id_number, b.user_id, b.transaction_cd,
            lkp_emp.attribute_name AS employee_type_name,
            lkp_sts.attribute_name AS acco_sts_name,
            lkp_app.attribute_name AS approval_type_name,
            b.basic_salary, b.remarks
        FROM ${ref("silver", "dim_broker")} AS b
        LEFT JOIN ${ref("silver", "dim_attribute_lookup")} AS lkp_emp 
            ON lkp_emp.category = 'BRKTBROKER__EMPLOYEE_TYPE' AND b.employee_type = lkp_emp.attribute_code
        LEFT JOIN ${ref("silver", "dim_attribute_lookup")} AS lkp_sts 
            ON lkp_sts.category = 'BRKTBROKER__ACCO_STS' AND b.acco_sts = lkp_sts.attribute_code
        LEFT JOIN ${ref("silver", "dim_attribute_lookup")} AS lkp_app 
            ON lkp_app.category = 'BRKTBROKER__APPROVAL_CD' AND b.approval_cd = lkp_app.attribute_code
        WHERE b.is_current = true
    )
  ) AS s
  ON t.broker_cd = s.broker_cd 
  AND t.is_current = true 
  AND t.record_hash != s.record_hash
  WHEN MATCHED THEN
    UPDATE SET
      t._updated_at = run_time,
      t.valid_to = CAST(target_date AS TIMESTAMP),
      t.is_current = false;
}