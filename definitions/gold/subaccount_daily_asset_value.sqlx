config {
  // ===========================================================================
  // BƯỚC 1: Config metadata của file
  // ===========================================================================
  type: "incremental",
  schema: "gold",
  name: "subaccount_daily_asset_value",
  description: "Bảng Fact Gold: Giá trị tài sản hàng ngày tích hợp thông tin Dimension",
  uniqueKey: ["subaccount_daily_asset_value_key"],
  tags: ["gold", "asset_value", "fact"],
  bigquery: {
      partitionBy: "business_date",
      clusterBy: ["sub_acco_no"]
  }
}

js {
  // ============================================================================
  // BƯỚC 2. Điền thông tin về nguồn dữ liệu, key và độ chi tiết
  // ============================================================================
  const bronze_source_table = "CORTASSET";              // Nguồn gốc từ Bronze để lấy checkpoint
  const source_schema = "silver";                       // Source là layer silver
  const source_table = "fact_subaccount_daily_asset_value"; // Tên View ở silver
  const partition_col = "business_date";                // Cột phân vùng

  const surrogate_key = "subaccount_daily_asset_value_key"; // Tên trường key
  const hash_elements = ["sub_acco_no", "business_date"];   // Các trường cấu thành nên 1 dòng

  // ============================================================================
  // BƯỚC 3. Danh sách các cột Measures (không bao gồm cột từ Dimension)
  // ============================================================================
  const fact_cols = [
    "is_deleted", "warning_level", "warning_num",
    "cash_amt", "sec_val", "sec_mrg_val", "sec_pending_val", "sec_mrg_pending_val", 
    "cash_pending_amt", "advance_amt", "bought_not_post_amt", "dividend_cash_amt", 
    "dividend_sec_val", "dividend_right_val", "other_asset_val", "debit_margin_amt", 
    "debit_coop_amt", "debit_debt_amt", "debit_mor_amt", "debit_other_amt", 
    "debit_temp_amt", "total_interest_amt", "debit_margin_expired", "debit_coop_expired", 
    "debit_mor_expired", "cash_block_amt", "credit_limit", "debt_interest_avail_payment", 
    "need_to_addition_cash", "need_to_addition_sec", "need_to_sell", "total_asset", 
    "total_mrg_asset", "total_debit", "margin_rate", "credit_cash_amt", "credit_sec_amt", 
    "t0_buy_amt", "t1_buy_amt", "t2_buy_amt", "t0_sell_amt", "t1_sell_amt", "t2_sell_amt", 
    "dividend_cash_market_amt", "dividend_sec_market_amt", "nav_bi"
  ];

  // ============================================================================
  // BƯỚC 4: Một số biến hỗ trợ logic (không cần đụng vào)
  // ============================================================================
  const source_ref = ref(source_schema, source_table);
  const checkpoint_ref = ref("silver", "bronze_checkpoint");
}

-- ===========================================================================
-- LOGIC SQL (không cần đụng vào)
-- ===========================================================================
pre_operations {
  DECLARE run_time TIMESTAMP DEFAULT CURRENT_TIMESTAMP();
  DECLARE target_date DATE;

  ${incremental() 
    ? `SET target_date = ${dataform.projectConfig.vars.target_date 
        ? `DATE('${dataform.projectConfig.vars.target_date}')` 
        : `(SELECT latest_date FROM ${checkpoint_ref} WHERE table_name = '${bronze_source_table}')`
      };`
    : `SET target_date = NULL;`
  }

  ${when(!incremental(), `DROP TABLE IF EXISTS ${self()};`)}
}

WITH staging_data AS (
    SELECT
        -- 1. Tự tạo Surrogate Key vì Silver View đã bỏ
        ${func.generateHash(hash_elements.map(el => `CAST(f.${el} AS STRING)`))} AS ${surrogate_key},
        f.${partition_col},

        -- 2. Measures
        ${fact_cols.map(col => `f.${col}`).join(",\n        ")},

        -- 3. Entity Keys for Joins
        f.sub_acco_no,
        s.dim_subaccount_key AS subaccount_history_key,
        f.cust_no,
        c.dim_customer_key AS customer_history_key,
        s.broker_cd,
        b.dim_broker_key AS broker_history_key
        
    FROM ${source_ref} AS f
    
    -- Join với các Dimension layer Silver để lấy Key SCD2 tại thời điểm business_date
    ${func.joinHistory(ref("silver", "dim_subaccount"), "s", "f.sub_acco_no", "sub_acco_no", "f.business_date")}
    ${func.joinHistory(ref("silver", "dim_customer"), "c", "f.cust_no", "cust_no", "f.business_date")}
    ${func.joinHistory(ref("silver", "dim_broker"), "b", "s.broker_cd", "broker_cd", "f.business_date")}    

    ${when(incremental(), `WHERE f.${partition_col} = target_date`)}
)

SELECT
    -- Quản lý ingestion metadata tại layer Gold
    ${when(incremental(), `COALESCE(target._ingested_at, run_time)`, `run_time`)} AS _ingested_at,
    run_time AS _updated_at,
    stg.*
FROM staging_data AS stg
${when(incremental(), 
  `LEFT JOIN ${self()} AS target ON stg.${surrogate_key} = target.${surrogate_key} AND target.${partition_col} = target_date`
)}