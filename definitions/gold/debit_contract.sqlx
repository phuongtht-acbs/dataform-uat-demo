config {
    type: "incremental",
    schema: "gold",
    name: "debit_contract",
    description: "Current active state of Debit Contracts, combining static dimensional attributes with the latest accumulating balance facts.",
    tags: ["gold", "debit_contract", "current"],
    uniqueKey: ["contract_id"],
    bigquery: {
        partitionBy: "allo_date",
        clusterBy: ["sub_acco_no", "contract_id", "status"],
    },
    dependOnDependencyAssertions: true
}

js {
    const dim_table_ref = ref("gold", "debit_contract_history")
    const cur_fact_table_ref = ref("gold", "debit_contract_current_balance")
    const unique_key_col = "contract_id"
}

pre_operations {
  DECLARE run_time TIMESTAMP DEFAULT CURRENT_TIMESTAMP();
  ${when(!incremental(), `DROP TABLE IF EXISTS ${self()};`)}
}

SELECT
    -- ==========================================
    -- 0. SYSTEM STATUS & METADATA
    -- ==========================================
    ${when(incremental(), `COALESCE(target._ingested_at, run_time)`, `run_time`)} AS _ingested_at,
    run_time AS _updated_at,
    dim.is_deleted,
    fact.last_fact_date,

    -- ==========================================
    -- 1. IDENTIFIERS & KEYS
    -- ==========================================
    dim.contract_id,
    dim.sub_acco_no,
    dim.cust_no,
    dim.broker_cd,
    dim.cust_group_id,

    -- ==========================================
    -- 2. DATES & LINEAGE
    -- ==========================================
    dim.allo_date,
    dim.ref_no,
    dim.parent_date,
    dim.parent_no,
    dim.contr_date_from,
    dim.contr_date_to,
    dim.begin_int_date,
    dim.last_extend_date,
    dim.remarks,
    
    -- ==========================================
    -- 3. CATEGORICAL & LOOKUP ATTRIBUTES
    -- ==========================================
    dim.debit_type,
    dim.debit_type_name,
    dim.contract_type,
    dim.contract_type_name,
    dim.loan_type,
    dim.loan_type_name,
    dim.debttype_id,
    dim.status,
    dim.status_name,
    dim.int_type,
    dim.source_cd,
    dim.transaction_cd,

    -- ==========================================
    -- 4. RATES & CONFIGURATIONS
    -- ==========================================
    dim.in_rate,
    dim.out_rate,
    dim.min_interest,
    dim.manager_in_rate,
    dim.manager_out_rate,
    dim.min_manager,
    dim.free_interest_days,
    dim.extend_count,
    dim.calucate,
    dim.decimal_point,
    dim.round_type,
    dim.int_config_id,

    -- ==========================================
    -- 5. LATEST METRICS & BALANCES (From Fact)
    -- ==========================================
    dim.amount,
    fact.payed_amount, 
    fact.payed_interest,
    fact.due_interest,
    fact.payed_manager,
    fact.due_manager,
    fact.last_payed_date,

FROM ${dim_table_ref} AS dim
INNER JOIN ${cur_fact_table_ref} AS fact ON dim.${unique_key_col} = fact.${unique_key_col} AND dim.is_current
${when(incremental(), `LEFT JOIN ${self()} AS target ON dim.${unique_key_col} = target.${unique_key_col}`)}