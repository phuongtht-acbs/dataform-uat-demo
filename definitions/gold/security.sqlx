config {
    type: "table",
    schema: "gold",
    name: "security",
    description: "Thông tin hiện tại của mã chứng khoán (Lọc từ security_history với điều kiện bản ghi mới nhất)",
    tags: ["gold", "security", "current"]
}

SELECT *
FROM ${ref("gold", "security_history")}
WHERE is_current = true