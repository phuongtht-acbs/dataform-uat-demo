config {
  // ===========================================================================
  // BƯỚC 1: Config metadata của file
  // ===========================================================================
  type: "incremental",
  schema: "gold",
  name: "cash_movement",
  description: "Bảng thông tin giao dịch tiền đã được denormalized.",
  uniqueKey: ["cash_movement_key"],
  tags: ["gold", "cash_movement", "fact"],
  bigquery: {
      partitionBy: "business_date",
      clusterBy: ["sub_acco_no", "cust_no"]
  }
}

js {
  // ============================================================================
  // BƯỚC 2. Điền thông tin về nguồn dữ liệu, key và độ chi tiết
  // ============================================================================
  const bronze_source_table = "CORTCASH_MOVEMENT_HISTORY"; // Nguồn gốc từ Bronze để lấy checkpoint
  const source_schema = "silver";                          // Source là layer silver
  const source_table = "fact_cash_movement";               // Tên View ở silver (không có metadata/hash)
  const partition_col = "business_date";                   // Cột phân vùng

  const surrogate_key = "cash_movement_key";               // Tên key bảng Gold
  const hash_elements = ["'VGaia'", "cash_movement_id"];   // Tự tạo hash tại layer Gold

  // ============================================================================
  // BƯỚC 3. Danh sách các trường được lấy từ bảng fact
  // (không bao gồm thông tin về các đối tượng)
  // ============================================================================
  const fact_cols = [
    "allo_date", "ref_no", "is_deleted",
    "entry_date", "approvement_id", "group_category", "task_cd", "src_date", "src_no",
    "src_transaction_cd", "curr_cd", "begin_amount", "amount", "amount_type", "trade_type",
    "after_amount", "util_cd", "util_cash_id", "status", "transaction_cd",
    "internal_balance_code", "doc", "remarks", "memo"
  ];

  // ============================================================================
  // BƯỚC 4: Một số biến hỗ trợ logic (không cần đụng vào)
  // ============================================================================
  const source_ref = ref(source_schema, source_table);
  const checkpoint_ref = ref("silver", "bronze_checkpoint");
}

-- ===========================================================================
-- LOGIC SQL (không cần đụng vào)
-- ===========================================================================
pre_operations {
  DECLARE run_time TIMESTAMP DEFAULT CURRENT_TIMESTAMP();
  DECLARE target_date DATE;

  ${incremental() 
    ? `SET target_date = ${dataform.projectConfig.vars.target_date 
        ? `DATE('${dataform.projectConfig.vars.target_date}')` 
        : `(SELECT latest_date FROM ${checkpoint_ref} WHERE table_name = '${bronze_source_table}')`
      };`
    : `SET target_date = NULL;`
  }

  ${when(!incremental(), `DROP TABLE IF EXISTS ${self()};`)}
}

WITH staging_data AS (
    SELECT
        ${func.generateHash(hash_elements.map(el => 
            el.includes("'") ? el : `CAST(f.${el} AS STRING)`
        ))} AS ${surrogate_key},
        ${partition_col},
        
        f.sub_acco_no, s.subaccount_history_key,
        f.cust_no, c.customer_history_key,
        s.broker_cd, b.broker_history_key

        ${fact_cols.map(col => `f.${col}`).join(",\n        ")},

        lkp_trade.attribute_name AS trade_type_name,
        lkp_sts.attribute_name AS status_name,

    FROM ${source_ref} AS f

-- ==========================================
-- Join để lấy giá trị chữ của các thuộc tính
-- ==========================================
    LEFT JOIN ${ref("silver", "dim_attribute_lookup")} AS lkp_trade 
        ON lkp_trade.category = 'CORTCASH_MOVEMENT__TRADE_TYPE' AND f.trade_type = lkp_trade.attribute_code
    LEFT JOIN ${ref("silver", "dim_attribute_lookup")} AS lkp_sts 
        ON lkp_sts.category = 'CORTCASH_MOVEMENT__STATUS' AND f.status = lkp_sts.attribute_code
        
-- ==========================================
-- Join với các bảng dim để lấy history key
-- ==========================================
    ${func.joinHistory(ref("silver", "dim_subaccount"), "s", "f.sub_acco_no", "sub_acco_no", "f.business_date")}
    ${func.joinHistory(ref("silver", "dim_customer"), "c", "f.cust_no", "cust_no", "f.business_date")}
    ${func.joinHistory(ref("silver", "dim_broker"), "b", "s.broker_cd", "broker_cd", "f.business_date")}
    
    ${when(incremental(), `WHERE f.${partition_col} = target_date`)}
)

SELECT
    -- Quản lý ingestion metadata tại layer Gold
    ${when(incremental(), `COALESCE(target._ingested_at, run_time)`, `run_time`)} AS _ingested_at,
    run_time AS _updated_at,
    stg.*
FROM staging_data AS stg
${when(incremental(), 
  `LEFT JOIN ${self()} AS target ON stg.${surrogate_key} = target.${surrogate_key} AND target.${partition_col} = target_date`
)}