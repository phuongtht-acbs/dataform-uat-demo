config {
    type: "incremental",
    schema: "gold",
    name: "cash_movement",
    description: "Bảng thông tin giao dịch tiền đã được denormalized.",
    tags: ["gold", "cash_movement", "fact"],
    uniqueKey: ["cash_movement_key"],
    bigquery: {
        partitionBy: "business_date",
        clusterBy: ["sub_acco_no", "cust_no"]
    },
}

js {
  const source_layer = "silver";
  const source_table = "fact_cash_movement";
  const source_partition_col = "business_date";
  const target_partition_col = "business_date";
  const hash_key_name = "cash_movement_key";

  // 4. DANH SÁCH CÁC TRƯỜNG ĐƯỢC LẤY TỪ BẢNG FACT
  //(không bao gồm thông tin về các đối tượng)
  const fact_cols = [
    "business_date", "allo_date", "ref_no", "is_deleted",
    "entry_date", "approvement_id", "group_category", "task_cd", "src_date", "src_no",
    "src_transaction_cd", "curr_cd", "begin_amount", "amount", "amount_type", "trade_type",
    "after_amount", "util_cd", "util_cash_id", "status", "transaction_cd",
    "internal_balance_code", "doc", "remarks", "memo"
  ];
}

pre_operations {
  -- 1. Declare biến
  DECLARE run_time TIMESTAMP DEFAULT CURRENT_TIMESTAMP();
  DECLARE target_date DATE;
  DECLARE start_date DATE;
  DECLARE end_date DATE;

  -- 2. Xác định target_date, start_date, end_date
  ${incremental() 
    ? `SET target_date = ${dataform.projectConfig.vars.target_date 
        ? `DATE('${dataform.projectConfig.vars.target_date}')` 
        : `(SELECT MAX(${source_partition_col}) FROM ${ref(source_layer, source_table)})`
      };`
    : `SET start_date = ${dataform.projectConfig.vars.start_date 
        ? `DATE('${dataform.projectConfig.vars.start_date}')` 
        : `(SELECT MIN(${source_partition_col}) FROM ${ref(source_layer, source_table)})`
      };
      SET end_date = ${dataform.projectConfig.vars.end_date 
        ? `DATE('${dataform.projectConfig.vars.end_date}')` 
        : `(SELECT MAX(${source_partition_col}) FROM ${ref(source_layer, source_table)})`
      };
      SET target_date = NULL;`
  }
  -- 3. Xử lý Drop table khi full refresh để tránh lỗi schema thay đổi
  ${when(!incremental(),`DROP TABLE IF EXISTS ${self()};`)}
}

WITH staging_data AS (
    SELECT
        -- 1. Xác định key của bảng
        f.${hash_key_name},

        -- 2. Các cột từ bảng fact
        ${fact_cols.map(col => `f.${col}`).join(",\n        ")},

        -- 3. Giá trị của các attribte được đánh số
        lkp_trade.attribute_name AS trade_type_name,
        lkp_sts.attribute_name AS status_name,

        -- 4. Natural Keys & History Keys sau khi dùng joinHistory
        f.sub_acco_no,
        s.subaccount_history_key,
        f.cust_no,
        s.customer_history_key,
        s.broker_cd,
        s.broker_history_key
        
    FROM ${ref(source_layer, source_table)} AS f
    
    -- --- JOINS ---
    -- 1. Join để tìm giá trị cho các attribute được đánh số
    LEFT JOIN ${ref("silver", "dim_attribute_lookup")} AS lkp_trade 
        ON lkp_trade.category = 'CORTCASH_MOVEMENT__TRADE_TYPE' AND f.trade_type = lkp_trade.attribute_code
    LEFT JOIN ${ref("silver", "dim_attribute_lookup")} AS lkp_sts 
        ON lkp_sts.category = 'CORTCASH_MOVEMENT__STATUS' AND f.status = lkp_sts.attribute_code
        
    -- 2. Dùng hàm joinHistory (ref_bảng, alias_bảng, left_key, right_key, join_date_col) để lấy ra foreign key của các đối tượng
    ${func.joinHistory(ref("gold", "subaccount_history"), "s", "f.sub_acco_no", "sub_acco_no", target_partition_col)}
    
    -- --- FILTER ---
    WHERE 
        -- Switch between single date (incremental) and date range (full refresh)
        ${incremental() 
          ? `${source_partition_col} = target_date` 
          : `${source_partition_col} BETWEEN start_date AND end_date`
        }
)

SELECT
    ${when(incremental(), `COALESCE(target._ingested_at, run_time)`, `run_time`)} AS _ingested_at,
    run_time AS _updated_at,
    stg.*
FROM staging_data AS stg
${when(incremental(), 
  `LEFT JOIN ${self()} AS target ON stg.${hash_key_name} = target.${hash_key_name} AND target.${target_partition_col} = target_date`
)}