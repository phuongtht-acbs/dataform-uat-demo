config {
    type: "table",
    schema: "gold",
    name: "customer_history",
    description: "Lịch sử thông tin của khách hàng. Lưu ý: thông tin tại thời điểm valid_from, bất kì thay đổi nào ở các đối tượng bên ngoài (như môi giới) sau valid_from sẽ không được phản ánh vào đây",
    tags: ["gold", "customer", "history"],
    bigquery: {
        partitionBy: 'DATE(valid_from)',
        clusterBy: ['is_current']
    }
}

js {
// ============================================================================
// BƯỚC 1: Config bảng dim nguồn từ silver
// ============================================================================
  const baseTable = {
    ref: ref("silver", "dim_customer"),
    alias: "t",
    columns: [ // Các array columns có thể chứa cả dạng "column_a as alias_b"
      "customer_history_key", "cust_no", "cust_cd", "cust_family_name",
      "cust_given_name", "tax_code", "birthday", "mobile_no", "email_adrs", "email_flg",
      "id_number", "issue_location", "issue_date", "expire_date", "country_cd", "job",
      "com3_cust_type", "pres_name", "pres_birthday", "pres_position", "pres_country_cd",
      "pres_id_number", "pres_issue_location", "pres_issue_date", "pres_expire_date",
      "pres_tel_no", "pres_email_adrs", "channel_id", "number_of_sig", "acco_divide",
      "acco_act_date", "acco_sts_date", "acco_str_date", "contract_complete_date",
      "contract_no", "order_money_conf", "order_stock_conf", "not_collect_tax",
      "reason_reject", "remarks", "sid", "pcod", "broker_cd", "transaction_cd",
      "introducer_cd", "department_cd"
    ],
    techColumns: ["valid_from", "valid_to", "is_current"]
  };
// ============================================================================
// BƯỚC 2: Config các bảng dim cần join để lấy history key
// ============================================================================
  const historyDimensions = [
    {
      ref: ref("silver", "dim_broker"),
      alias: "b",
      leftKey: "t.broker_cd",
      rightKey: "broker_cd",
      columns: ["broker_history_key"]
    },
    {
      ref: ref("silver", "dim_transaction"),
      alias: "tr",
      leftKey: "t.transaction_cd",
      rightKey: "transaction_cd",
      columns: ["transaction_history_key"]
    }
  ];
// ============================================================================
// BƯỚC 3: Config các thuộc tính cần tra cứu giá trị
// ============================================================================
  const lookupAttributes = {
    cust_type:       "CORTCUSTOMER__CUST_TYPE",
    foreign_type:    "CORTCUSTOMER__FOREIGN_TYPE",
    sex:             "CORTCUSTOMER__SEX",
    acco_sts:        "CORTCUSTOMER__ACCO_STS",
    vsd_status:      "CORTCUSTOMER__VSD_STATUS",
    contract_status: "CORTCUSTOMER__CONTRACT_STATUS",
    approval_cd:     "CORTCUSTOMER__APPROVAL_CD",
    src_channel:     "CORTCUSTOMER__SRC_CHANNEL"
  };

}

-- ============================================================================
-- LOGIC SQL (KHÔNG CẦN ĐỤNG VÀO)
-- ============================================================================

SELECT
    -- Các trường từ bảng dim gốc
   ${func.renderColumns(baseTable.columns, baseTable.alias)},

    -- Các history key và natural key từ các đối tượng khác
    ${func.renderHistoryColumns(historyDimensions)}

    -- Giá trị tên thuộc tính sau khi lookup bảng dim_attribute_lookup
    ${func.renderLookupColumns(lookupAttributes)}

    -- Thông tin SCD2 từ bảng dim gốc
    ${baseTable.techColumns.map(col => `${baseTable.alias}.${col}`).join(",\n    ")}

FROM ${baseTable.ref} AS ${baseTable.alias}

-- Join để lấy history key
${historyDimensions.map(
    j => func.joinHistory(j.ref, j.alias, j.leftKey, j.rightKey, `DATE(${baseTable.alias}.valid_from)`)
).join("\n")}

-- Join để lookup giá trị tên thuộc tính
${Object.entries(lookupAttributes).map(([col, category]) => `LEFT JOIN ${ref("silver", "dim_attribute_lookup")} AS lkp_${col}
    ON lkp_${col}.category = '${category}'
    AND cast(${baseTable.alias}.${col} as STRING) = cast(lkp_${col}.attribute_code as STRING)`).join("\n\n")}